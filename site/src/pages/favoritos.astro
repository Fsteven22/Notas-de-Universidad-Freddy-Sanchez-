---
/**
 * /favoritos/ — las notas que el lector guardó.
 *
 * La lista vive en el `localStorage` del navegador (nada sale de tu
 * dispositivo), así que esta página se pinta en el cliente: sin JavaScript
 * no hay lista, pero tampoco hay favoritos guardados.
 */
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Base
  title="Tus favoritos · Neonotes"
  description="Las notas que guardaste para tenerlas a mano"
>
  <SiteHeader
    variant="nivel"
    crumbs={[{ label: "Inicio", href: "/" }, { label: "Favoritos" }]}
  />

  <section class="mx-auto max-w-3xl px-6 pt-10 pb-20">
    <p class="nx-section-title">Tus favoritos</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
      Las notas que guardaste
    </h1>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[#e5e7eb]">
      Pulsa <span class="text-white">☆</span> en cualquier nota (en la nota o en la ficha de la
      materia) y aparecerá aquí. Se guardan en este navegador, así que no se envían a ningún
      servidor.
    </p>

    <ul class="nx-fav-lista" id="nx-fav-lista"></ul>

    <div class="nx-fav-vacio" id="nx-fav-vacio" hidden>
      <p class="text-sm font-semibold text-white">Todavía no has guardado nada</p>
      <p class="mt-1 text-sm text-[#e5e7eb]">
        Cuando guardes una nota, la encontrarás aquí: todo lo que marcaste, en una sola lista.
      </p>
    </div>
  </section>

  <script>
    import { favoritos } from "../lib/progreso.js";

    function pintar() {
      const lista = document.getElementById("nx-fav-lista");
      const vacio = document.getElementById("nx-fav-vacio");
      if (!lista || !vacio) return;
      const f = favoritos();
      const entradas = Object.entries(f).sort(
        (a, b) => (b[1].at || 0) - (a[1].at || 0)
      );
      lista.innerHTML = "";
      vacio.hidden = entradas.length > 0;
      for (const [url, m] of entradas) {
        const li = document.createElement("li");
        li.className = "nx-fav-item";
        const a = document.createElement("a");
        a.href = url;
        a.className = "nx-fav-item__link";
        const t = document.createElement("span");
        t.className = "nx-fav-item__t";
        t.textContent = m.t || url;
        const sub = document.createElement("span");
        sub.className = "nx-fav-item__sub";
        sub.textContent = [m.mt, m.s].filter(Boolean).join(" · ");
        a.append(t, sub);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "nx-fav-item__quitar";
        btn.setAttribute("data-nx-fav", "");
        btn.setAttribute("data-url", url);
        btn.setAttribute("data-t", m.t || "");
        btn.setAttribute("data-m", m.m || "");
        btn.setAttribute("data-mt", m.mt || "");
        btn.setAttribute("data-s", m.s || "");
        btn.setAttribute("aria-label", `Quitar "${m.t || url}" de favoritos`);
        btn.title = "Quitar de favoritos";
        btn.textContent = "×";
        li.append(a, btn);
        lista.appendChild(li);
      }
    }

    document.addEventListener("astro:page-load", pintar);
    // La delegación global alterna el favorito; al volver a pintar se ve el
    // cambio (el clic se atiende antes que este listener).
    document.addEventListener("click", (ev) => {
      const t = ev.target;
      if (!(t instanceof Element)) return;
      if (t.closest("[data-nx-fav]")) setTimeout(pintar, 0);
    });
    pintar();
  </script>
</Base>
