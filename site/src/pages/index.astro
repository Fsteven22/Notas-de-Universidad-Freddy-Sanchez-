---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import MotionToggle from "../components/MotionToggle.astro";
import vault from "../data/vault.json";
import { todasLasFlashcards } from "../lib/flashcards.mjs";
import { estadosSem, claseEstado } from "../lib/estados-sem.mjs";

function fecha(ms) {
  return new Date(ms).toLocaleDateString("es-EC", { day: "numeric", month: "short" }).toLowerCase();
}

/* El estado de cada semestre vive en ../lib/estados-sem.mjs: lo comparte
   con el mapa, que tiñe sus esferas según ese estado. */
const sems = vault.semestres.filter((s) => s.id !== "raiz");
// OJO: el acumulador "n" tiene que usarse. Si el callback lo ignora,
// reduce() se queda con el valor del ÚLTIMO semestre y la portada muestra
// 181 notas / 5 materias / 113 PDFs en vez de 822 / 18 / 220.
const totalNotas = sems.reduce(
  (n, s) => n + s.materias.reduce((m, x) => m + x.total, 0),
  0
);
const totalMaterias = sems.reduce((n, s) => n + s.materias.length, 0);
const totalPdf = sems.reduce(
  (n, s) => n + s.materias.reduce((m, x) => m + (x.pdfs?.length || 0), 0),
  0
);

const subEstado = (id) => estadosSem[id] ?? "";

// Tarjetas de repaso que ya vienen escritas en las notas
const nTarjetas = todasLasFlashcards().length;

---

<Base title="Neonotes · Apuntes ESPOL">

  <SiteHeader variant="portada" />

  <!-- Hero: título corto, buscador grande y el resto en una línea -->
  <section class="mx-auto max-w-6xl px-6 pt-12 pb-12">
    <div>
      <span class="nx-badge">INGENIERÍA COMPUTACIONAL</span>
      <h1 class="nx-hero-title mt-3">Apuntes de ESPOL</h1>
      <p class="nx-hero-lead mt-3">
        ¿Tuviste el PDF y <span class="nx-brand-text">no sabes por dónde empezar?</span>
      </p>

      {/* El buscador es lo primero del sitio: ocupa todo el ancho del
          hero y abre el mismo buscador modal que la barra del header. */}
      <button type="button" class="nx-hero-search nx-search-open" aria-label="Buscar en apuntes">
        <svg
          class="nx-hero-search-icon size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <span class="nx-hero-search-text">Buscar en apuntes</span>
        <kbd class="nx-kbd">/</kbd>
      </button>

      <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[var(--nx-dim)]">
        Neonotes hace ese trabajo por ti: apuntes resumidos y ordenados por semestre, con
        gráficos, fórmulas y búsqueda por temas. ¿Te los quieres llevar? Cada materia se baja en un ZIP.
      </p>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a class="nx-link" href="/mapa/">Ver el mapa de la carrera</a>
        <a class="nx-link" href="#semestres">Explorar semestres</a>
      </div>

      {/* Los distintivos: lo que el sitio ya hace, dicho en tres palabras. */}
      <ul class="nx-hero-points">
        <li>Búsqueda por temas</li>
        <li>Gráficos y fórmulas</li>
        <li>ZIP por materia</li>
      </ul>
      {
        nTarjetas > 0 && (
          <a href="/estudio/" class="nx-hero-study">
            <span class="nx-hero-study__n">{nTarjetas}</span>
            tarjetas de repaso esperando en tus notas → prepárate con ellas
          </a>
        )
      }
      <p class="nx-stats">
        <strong>{totalNotas}</strong> notas · <strong>{totalMaterias}</strong> materias ·{" "}
        <strong>{totalPdf}</strong> PDFs · <strong>{sems.length}</strong> semestres
      </p>
    </div>
  </section>

  <!-- Semestres: tres columnas de texto, sin cards ni bordes de color -->
  <section id="semestres" class="mx-auto max-w-6xl px-6 pt-8 pb-10">
    <p class="nx-section-title mb-6">Semestres</p>
    <div class="nx-sem-grid">
      {
        sems.map((s) => (
          <div class="nx-sem-col">
            <div class="nx-sem-head">
              <a href={`/${s.id}/`} class="nx-sem-title">
                {s.title}
              </a>
              {subEstado(s.id) && (
                <span class:list={["nx-sem-state", claseEstado(subEstado(s.id))]}>
                  {subEstado(s.id)}
                </span>
              )}
            </div>
            <ul class="nx-sem-list">
              {s.materias.map((m) => (
                <li>
                  <a href={`/${s.id}/${m.id}/`}>{m.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Continuar leyendo (lo llena Base.astro desde localStorage) -->
  <section id="continuar" class="mx-auto max-w-6xl px-6 py-8 hidden">
    <p class="nx-section-title mb-4">Continuar leyendo</p>
    <a id="continuar-card" href="#" class="nx-row">
      <span id="continuar-title" class="nx-row-title"></span>
      <span class="nx-row-meta">
        <span id="continuar-mat"></span>
        <span id="continuar-when"></span>
      </span>
    </a>
  </section>

  <!-- Todas las materias, con filtro por semestre -->
  <section id="materias" class="mx-auto max-w-6xl px-6 py-8">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
      <p class="nx-section-title">Todas las materias</p>
      <div class="nx-chips" role="group" aria-label="Filtrar por semestre">
        <button
          type="button"
          class="nx-chip is-active"
          data-nx-filter="todas"
          aria-pressed="true"
        >
          Todas
        </button>
        {
          sems.map((s) => (
            <button
              type="button"
              class="nx-chip"
              data-nx-filter={s.id}
              aria-pressed="false"
            >
              {s.title}
            </button>
          ))
        }
      </div>
    </div>
    <div class="nx-table-wrap">
      <table class="nx-table" data-nx-mat-table>
        <thead>
          <tr>
            <th scope="col" aria-sort="none" data-nx-sort="mat">
              <button type="button" class="nx-table-sort" data-nx-sort-btn>Materia</button>
            </th>
            <th scope="col" class="nx-table-col-sem" aria-sort="none" data-nx-sort="sem">
              <button type="button" class="nx-table-sort" data-nx-sort-btn>Semestre</button>
            </th>
            <th scope="col" class="nx-table-col-num" aria-sort="none" data-nx-sort="notas">
              <button type="button" class="nx-table-sort" data-nx-sort-btn>Notas</button>
            </th>
            <th scope="col" class="nx-table-col-num" aria-sort="none" data-nx-sort="pdfs">
              <button type="button" class="nx-table-sort" data-nx-sort-btn>PDFs</button>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            sems.flatMap((s) =>
              s.materias.map((m) => (
                <tr
                  class="nx-mat-row"
                  data-nx-sem={s.id}
                  data-nx-orden-mat={m.title.toLowerCase()}
                  data-nx-orden-sem={s.title.toLowerCase()}
                  data-nx-orden-notas={m.total}
                  data-nx-orden-pdfs={m.pdfs?.length || 0}
                >
                  <td>
                    <a href={`/${s.id}/${m.id}/`} class="nx-table-title">
                      {m.title}
                    </a>
                  </td>
                  <td class="nx-table-col-sem">{s.title}</td>
                  <td class="nx-table-col-num">{m.total}</td>
                  <td class="nx-table-col-num">{m.pdfs?.length ? m.pdfs.length : "—"}</td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
    <p
      id="materias-empty"
      class="hidden text-[11px] text-[var(--nx-muted)]"
    >
      Sin materias en ese semestre.
    </p>
  </section>

  <!-- Recién actualizadas -->
  <section id="recientes" class="mx-auto max-w-6xl px-6 py-8 pb-16">
    <p class="nx-section-title mb-4">Recién actualizadas</p>
    <ul class="nx-rows">
      {
        vault.recent.filter((r) => r.sem !== "raiz").map((r) => (
          <li>
            <a href={r.url} class="nx-row">
              <span class="nx-row-title">
                <span class="nx-row-mat">{r.matTitle}</span>
                <span class="nx-row-sep" aria-hidden="true">›</span>
                {r.title}
              </span>
              <span class="nx-row-meta">{fecha(r.mtime)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* El pie de página (marca, avisos, fecha, atajos y movimiento) lo
      monta Base.astro: ahora todas las páginas terminan igual. */}

  <script is:inline>
    // Filtro de materias por semestre + tabla ordenable + tarjeta
    // "Continuar leyendo".
    // is:inline: se ejecuta en cada visita a la portada (el ClientRouter
    // deduplica por contenido, así que usamos astro:page-load abajo).
    (function(){
      function nxIndexUI(){
        // ── Filtro por semestre ──
        var chips = document.querySelectorAll("[data-nx-filter]");
        var rows = document.querySelectorAll(".nx-mat-row");
        var empty = document.getElementById("materias-empty");
        var tabla = document.querySelector("[data-nx-mat-table]");
        chips.forEach(function(chip){
          if (chip.dataset.nxBound) return;
          chip.dataset.nxBound = "1";
          chip.addEventListener("click", function(){
            var f = chip.getAttribute("data-nx-filter");
            chips.forEach(function(c){
              var on = c === chip;
              c.classList.toggle("is-active", on);
              c.setAttribute("aria-pressed", on ? "true" : "false");
            });
            var visible = 0;
            rows.forEach(function(row){
              var show = f === "todas" || row.getAttribute("data-nx-sem") === f;
              row.classList.toggle("is-filtered-out", !show);
              if (show) visible++;
            });
            if (empty) empty.classList.toggle("hidden", visible > 0);
            // Con un semestre elegido, la columna del semestre sobra: se
            // esconde para que la tabla quede más ancha y más limpia.
            if (tabla) tabla.classList.toggle("is-sem-filtrada", f !== "todas");
          });
        });

        // ── Tabla ordenable ──
        // Cada <th> con data-nx-sort ordena por su columna. El estado vive
        // en aria-sort, que además es lo que lee un lector de pantalla.
        var ths = document.querySelectorAll("[data-nx-sort]");
        ths.forEach(function(th){
          var btn = th.querySelector("[data-nx-sort-btn]");
          if (!btn || btn.dataset.nxBound) return;
          btn.dataset.nxBound = "1";
          btn.addEventListener("click", function(){
            var clave = th.getAttribute("data-nx-sort");
            var ascendente = th.getAttribute("aria-sort") !== "ascending";
            ths.forEach(function(o){
              if (o !== th) o.setAttribute("aria-sort", "none");
            });
            th.setAttribute("aria-sort", ascendente ? "ascending" : "descending");
            var cuerpo = th.closest("table").querySelector("tbody");
            var lista = Array.prototype.slice.call(cuerpo.querySelectorAll(".nx-mat-row"));
            lista.sort(function(a, b){
              var va = a.getAttribute("data-nx-orden-" + clave);
              var vb = b.getAttribute("data-nx-orden-" + clave);
              var na = parseFloat(va), nb = parseFloat(vb);
              if (!isNaN(na) && !isNaN(nb)) {
                return ascendente ? na - nb : nb - na;
              }
              return ascendente
                ? va.localeCompare(vb, "es")
                : vb.localeCompare(va, "es");
            });
            lista.forEach(function(row){ cuerpo.appendChild(row); });
          });
        });

        // ── Continuar leyendo (localStorage "nx-last") ──
        var sec = document.getElementById("continuar");
        var cardEl = document.getElementById("continuar-card");
        if (sec && cardEl && !sec.dataset.nxBound) {
          sec.dataset.nxBound = "1";
          try {
            var raw = localStorage.getItem("nx-last");
            if (raw) {
              var d = JSON.parse(raw);
              if (d && d.url && d.title) {
                cardEl.setAttribute("href", d.url);
                document.getElementById("continuar-title").textContent = d.title;
                document.getElementById("continuar-mat").textContent = d.mat || "";
                var days = Math.floor((Date.now() - (d.at || 0)) / 86400000);
                document.getElementById("continuar-when").textContent =
                  d.mat ? " · " + (days <= 0 ? "hoy" : "hace " + days + " d") :
                  (days <= 0 ? " · hoy" : " · hace " + days + " d");
                sec.classList.remove("hidden");
              }
            }
          } catch(e){}
        }
      }
      document.addEventListener("astro:page-load", nxIndexUI);
      nxIndexUI();
    })();
  </script>

  <!-- Atajos: una línea al pie, con las teclas a la vista -->
  <section class="mx-auto max-w-6xl px-6 pb-16">
    <p class="nx-section-title mb-3">Atajos</p>
    <p class="nx-shortcuts">
      <span class="nx-shortcut"><kbd class="nx-kbd">g</kbd><kbd class="nx-kbd">h</kbd> Inicio</span>
      <span class="nx-shortcut"><kbd class="nx-kbd">g</kbd><kbd class="nx-kbd">i</kbd> Índice</span>
      <span class="nx-shortcut"><kbd class="nx-kbd">g</kbd><kbd class="nx-kbd">b</kbd> Buscar</span>
      <span class="nx-shortcut"><kbd class="nx-kbd">/</kbd> Buscar rápido</span>
      <span class="nx-shortcut"><kbd class="nx-kbd">?</kbd> Ver todos</span>
    </p>
    <p class="mt-3 text-[13px] leading-relaxed text-[var(--nx-muted)]">
      Las de dos teclas van seguidas: <kbd class="nx-kbd">g</kbd> y luego la otra. También vale
      <kbd class="nx-kbd">ctrl</kbd> + <kbd class="nx-kbd">k</kbd> para buscar.
    </p>
    <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] leading-relaxed text-[var(--nx-muted)]">
      <span>
        Si las animaciones no se ven, el sistema puede estar pidiendo "reducir movimiento".
        <a href="?motion=1" class="nx-link">
          Forzar animaciones
        </a>
        .
      </span>
      <MotionToggle />
    </p>
  </section>

</Base>
