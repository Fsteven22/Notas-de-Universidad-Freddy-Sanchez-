---
import Base from "../../../layouts/Base.astro";
import Explorer from "../../../components/Explorer.astro";
import NoteToc from "../../../components/NoteToc.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import "../../../styles/content.css";
import "katex/dist/katex.min.css";
import vault from "../../../data/vault.json";

export function getStaticPaths() {
  return vault.semestres.flatMap((s) =>
    s.materias.flatMap((m) =>
      m.notas.map((n) => ({
        params: {
          sem: s.id,
          mat: m.id,
          slug: n.units?.length ? [...n.units, n.slug].join("/") : n.slug,
        },
      }))
    )
  );
}

const { sem, mat, slug } = Astro.params;
const semData = vault.semestres.find((s) => s.id === sem);
const matData = semData?.materias.find((m) => m.id === mat);
if (!matData) return Astro.redirect("/");
const file = `${sem}/${mat}/${slug ?? ""}`;
const note = matData.notas.find((n) => n.file === file);
if (!note) return Astro.redirect(`/${sem}/${mat}/`);

const mods = import.meta.glob("/notes-md/**/*.md");
const key = `/notes-md/${file}.md`;
const mod = mods[key];
if (!mod) return Astro.redirect(`/${sem}/${mat}/`);
const { Content } = await mod();

/* Tiempo de lectura: se cuenta el texto del markdown de origen (no el HTML
   compilado, que duplica el texto por el MathML de KaTeX). Se quitan el
   frontmatter, los bloques de código y las fórmulas. */
const raws = import.meta.glob("/notes-md/**/*.md", { query: "?raw", import: "default" });
const raw = (await raws[key]?.()) ?? "";
const palabras = raw
  .replace(/^---[\s\S]*?---/m, "")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/`[^`]*`/g, " ")
  .replace(/\$\$[\s\S]*?\$\$/g, " ")
  .replace(/\$[^$\n]*\$/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[\[([^\]|]*\|)?([^\]]*)\]\]/g, " ")
  .replace(/https?:\/\/\S+/g, " ")
  .replace(/[#>*_|~-]/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;
const minutos = Math.max(1, Math.round(palabras / 200));

function fecha(ms) {
  return new Date(ms).toLocaleDateString("es-EC", { day: "numeric", month: "short", year: "numeric" }).toLowerCase();
}

/* Convierte un slug de unidad en texto legible:
   "unidad-2-limites" → "Unidad 2 Límites" (los números romanos en
   mayúsculas y las palabras cortas en minúscula, como el resto del sitio). */
const MENORES = new Set([
  "de", "del", "la", "las", "los", "y", "en", "para", "por", "a", "e", "al",
]);
const ROMANOS = /^[ivxlcdm]{1,5}$/i;
const pretty = (slug: string) =>
  slug
    .split("-")
    .map((w, i) => {
      if (!w) return w;
      if (ROMANOS.test(w)) return w.toUpperCase();
      if (i > 0 && MENORES.has(w.toLowerCase())) return w.toLowerCase();
      return w.charAt(0).toUpperCase() + w.slice(1);
    })
    .join(" ");

// secuencia de notas de la materia (para Anterior/Siguiente)
const notasOrdenadas = matData.notas
  .map((n) => ({ n, k: (n.units?.length ? n.units.join("/") : "") + "/" + n.slug }))
  .sort((a, b) => a.k.localeCompare(b.k, "es", { numeric: true }));
const iOrd = notasOrdenadas.findIndex((x) => x.n.file === note.file);
const prev = iOrd > 0 ? notasOrdenadas[iOrd - 1].n : null;
const next = iOrd < notasOrdenadas.length - 1 ? notasOrdenadas[iOrd + 1].n : null;
const noteUrl = (n) => `/${sem}/${mat}${n.units?.length ? "/" + n.units.join("/") : ""}/${n.slug}/`;

// Dónde estás dentro de la materia: "Unidad 3 › IV. Derivadas direccionales"
const unitPath = (note.units ?? []).map(pretty).join(" › ");
const matUrl = `/${sem}/${mat}/`;
---

<Base title={`${note.title} · ${matData.title} · Neonotes`} description={`Apuntes de ${note.title} · ${matData.title} · ${semData.title}`}>
  <SiteHeader
    variant="nota"
    container="max-w-[1320px]"
    sticky
    showIndex
    crumbs={[
      { label: semData.title, href: `/${sem}/` },
      { label: matData.title, href: matUrl },
      { label: note.title },
    ]}
  />

  <main class="nx-with-explorer nx-note-layout mx-auto max-w-[1320px] gap-10 px-6 pt-8 pb-20">
    <Explorer semId={sem} matId={mat} currentUrl={`/${file}/`} />
    <article>
      <h1 class="mt-1 text-3xl font-bold sm:text-4xl">{note.title}</h1>

      {/* Una sola línea de metadatos, en gris: dónde estás, cuánto tarda
          y cuándo se editó por última vez. */}
      <p class="nx-note-meta">
        <span>{unitPath ? unitPath : `${semData.title} › ${matData.title}`}</span>
        <span class="nx-note-meta__sep" aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
        <span class="nx-note-meta__sep" aria-hidden="true">·</span>
        <span>editada el {fecha(note.mtime)}</span>
      </p>

      {/* Las acciones son iconos (el rótulo va en el tooltip). */}
      <div class="nx-note-tools">
        <button
          type="button"
          id="nx-lectura"
          class="nx-note-tools__btn"
          aria-pressed="false"
          title="Modo lectura"
        >
          <span class="nx-note-tools__ico" data-nx-lectura-ico aria-hidden="true">◐</span>
          <span class="nx-sr-only" data-nx-lectura-txt>Modo lectura</span>
        </button>
        <button type="button" id="nx-imprimir" class="nx-note-tools__btn" title="Imprimir / PDF">
          <span class="nx-note-tools__ico" aria-hidden="true">⎙</span>
          <span class="nx-sr-only">Imprimir / PDF</span>
        </button>
        <button
          type="button"
          class="nx-note-tools__btn nx-fav-btn"
          data-nx-fav
          aria-pressed="false"
          data-url={`/${file}/`}
          data-t={note.title}
          data-m={mat}
          data-mt={matData.title}
          data-s={sem}
          title="Guardar esta nota en tus favoritos"
        >
          <span class="nx-note-tools__ico" data-nx-fav-ico aria-hidden="true">☆</span>
          <span class="nx-sr-only" data-nx-fav-txt>Guardar</span>
        </button>
        <button
          type="button"
          class="nx-note-tools__btn nx-hecha-btn"
          data-nx-hecha
          aria-pressed="false"
          data-url={`/${file}/`}
          data-t={note.title}
          data-m={mat}
          data-mt={matData.title}
          data-s={sem}
          title="Marcar esta nota como leída (para llevar tu avance)"
        >
          <span class="nx-note-tools__ico" data-nx-hecha-ico aria-hidden="true">○</span>
          <span class="nx-sr-only" data-nx-hecha-txt>Marcar leída</span>
        </button>
        {/* Emojis: el vault los usa en los títulos y en los callouts.
            Este interruptor los quita (o los deja) sin tocar el vault. */}
        <button
          type="button"
          id="nx-emojis"
          class="nx-note-tools__btn"
          aria-pressed="true"
          title="Emojis: sí/no"
        >
          <span class="nx-note-tools__ico" aria-hidden="true">☺</span>
          <span class="nx-sr-only">Emojis: sí/no</span>
        </button>
      </div>

      <div class="note-prose mt-8">
        <Content />
      </div>

      {/* Al final de la nota: terminar y pasar a la siguiente. */}
      <div class="nx-note-fin">
        <span>¿Terminaste esta nota?</span>
        <button
          type="button"
          class="nx-note-fin__btn nx-hecha-btn"
          data-nx-hecha
          aria-pressed="false"
          data-url={`/${file}/`}
          data-t={note.title}
          data-m={mat}
          data-mt={matData.title}
          data-s={sem}
          title="Marcar esta nota como leída (para llevar tu avance)"
        >
          <span class="nx-note-tools__ico" data-nx-hecha-ico aria-hidden="true">○</span>
          <span data-nx-hecha-txt>Marcar leída</span>
        </button>
      </div>

      {/* Navegación entre notas: filas con línea de 1 px. */}
      <nav class="nx-note-nav" aria-label="Notas anterior y siguiente">
        {
          prev ? (
            <a href={noteUrl(prev)} class="nx-note-nav__item">
              <span class="nx-note-nav__label">← Anterior</span>
              <span class="nx-note-nav__title">{prev.title}</span>
            </a>
          ) : <span />
        }
        <a href={matUrl} class="nx-note-nav__item">
          <span class="nx-note-nav__label">Materia</span>
          <span class="nx-note-nav__title">{matData.title}</span>
        </a>
        {
          next ? (
            <a href={noteUrl(next)} class="nx-note-nav__item nx-note-nav__item--next">
              <span class="nx-note-nav__label">Siguiente →</span>
              <span class="nx-note-nav__title">{next.title}</span>
            </a>
          ) : <span />
        }
      </nav>
    </article>

    <NoteToc
      unitPath={unitPath}
      matTitle={matData.title}
      matUrl={matUrl}
      prev={prev ? { title: prev.title, url: noteUrl(prev) } : null}
      next={next ? { title: next.title, url: noteUrl(next) } : null}
    />
  </main>

  <script>
    type NxPdfFrame = HTMLIFrameElement;

    function pdfFrameMap() {
      const w = window as any;
      if (!w.__nxPdfFrames) w.__nxPdfFrames = new Map<Window, NxPdfFrame>();
      return w.__nxPdfFrames as Map<Window, NxPdfFrame>;
    }

    function mountPdf(card: HTMLElement) {
      if (card.dataset.nxPdfMounted) return;
      card.dataset.nxPdfMounted = "1";
      const slot = card.querySelector(".nx-pdf-slot");
      const src = card.dataset.nxPdfSrc;
      if (!slot || !src) return;
      const frame = document.createElement("iframe");
      frame.className = "nx-pdf-frame";
      frame.src = src;
      frame.title = card.querySelector(".nx-pdf-name")?.textContent?.trim() || "Visor PDF";
      frame.setAttribute("referrerpolicy", "no-referrer");
      frame.setAttribute("allowfullscreen", "");
      frame.setAttribute("loading", "lazy");
      slot.appendChild(frame);
      pdfFrameMap().set(frame.contentWindow, frame);

      const more = document.createElement("div");
      more.className = "nx-pdf-more";
      slot.after(more);
      moreObserver().observe(more);

      const btn = card.querySelector("[data-nx-pdf-open]");
      if (btn instanceof HTMLButtonElement) {
        btn.textContent = "Abierto";
        btn.disabled = true;
      }
    }

    function moreObserver() {
      const w = window as any;
      if (!w.__nxPdfMoreObserver) {
        w.__nxPdfMoreObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const card = (entry.target as HTMLElement).closest<HTMLElement>(".nx-pdf");
              const frame = card?.querySelector<HTMLIFrameElement>("iframe.nx-pdf-frame");
              if (frame?.contentWindow) {
                frame.contentWindow.postMessage({ type: "nx-pdf-more" }, location.origin);
              }
            }
          },
          { rootMargin: "300px 0px" }
        );
      }
      return w.__nxPdfMoreObserver as IntersectionObserver;
    }

    function bindPdfMessages() {
      const w = window as any;
      if (w.__nxPdfMsgBound) return;
      w.__nxPdfMsgBound = true;
      window.addEventListener("message", (e) => {
        if (e.origin !== location.origin) return;
        const d = e.data || {};
        if (d.type !== "nx-pdf-height") return;
        const frame = pdfFrameMap().get(e.source as Window);
        if (!frame) return;
        const h = Math.max(420, Math.round(Number(d.h) || 0));
        frame.style.height = `${h}px`;
      });
    }

    function initPdfLazy() {
      bindPdfMessages();
      const cards = Array.from(document.querySelectorAll<HTMLElement>(".nx-pdf[data-nx-pdf-src]"));
      if (!cards.length) return;
      const w = window as any;
      if (!w.__nxPdfObserver) {
        w.__nxPdfObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              w.__nxPdfObserver.unobserve(entry.target);
              mountPdf(entry.target as HTMLElement);
            }
          },
          { rootMargin: "400px 0px" }
        );
      }
      const io = w.__nxPdfObserver as IntersectionObserver;
      for (const card of cards) {
        if (card.dataset.nxPdfLazyReady) continue;
        card.dataset.nxPdfLazyReady = "1";
        io.observe(card);
      }
      document.querySelectorAll<HTMLButtonElement>("[data-nx-pdf-open]").forEach((btn) => {
        if (btn.dataset.nxPdfBound) return;
        btn.dataset.nxPdfBound = "1";
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>(".nx-pdf");
          if (!card) return;
          io.unobserve(card);
          mountPdf(card);
        });
      });
    }

    function boot() {
      // Recuerda dónde quedaste: la portada lo muestra en "Continuar leyendo"
      try {
        const parts = document.title.split(" · ");
        localStorage.setItem("nx-last", JSON.stringify({
          title: parts[0] || "",
          mat: parts[1] || "",
          url: location.pathname,
          at: Date.now(),
        }));
      } catch {}
      initPdfLazy();
    }
    document.addEventListener("astro:page-load", boot);
    boot();
  </script>

  <script>
    /**
     * Modo lectura + impresión + emojis.
     *
     * · "Modo lectura": quita header, pie, explorador, índice y fondo, y deja
     *   la nota sola, con más cuerpo. La preferencia se guarda (localStorage)
     *   y se aplica en todas las notas.
     * · "Imprimir / PDF": abre el diálogo del navegador, que con la hoja de
     *   estilos de impresión saca la nota en blanco y negro, lista para
     *   guardarse como PDF. Es la respuesta al "¿tuviste el PDF?": ahora la
     *   nota también se puede llevar en PDF.
     * · "Emojis: sí/no": quita (o deja) los emojis de los títulos y de los
     *   iconos de los callouts. La preferencia vive en el <head> (Base.astro);
     *   aquí solo se cambia el icono del botón.
     */
    (function () {
      var KEY = "nx-lectura";
      var html = document.documentElement;

      function leer() {
        try { return localStorage.getItem(KEY) === "1"; } catch (e) { return false; }
      }
      function guardar(v) {
        try { localStorage.setItem(KEY, v ? "1" : "0"); } catch (e) {}
      }

      function aplicar() {
        var activo = leer();
        html.classList.toggle("nx-lectura", activo);
        var btn = document.getElementById("nx-lectura");
        if (btn) {
          btn.setAttribute("aria-pressed", activo ? "true" : "false");
          btn.setAttribute("title", activo ? "Salir del modo lectura" : "Modo lectura");
          var ico = btn.querySelector("[data-nx-lectura-ico]");
          if (ico) ico.textContent = activo ? "◑" : "◐";
          var txt = btn.querySelector("[data-nx-lectura-txt]");
          if (txt) txt.textContent = activo ? "Salir del modo lectura" : "Modo lectura";
        }
      }

      /* ── Emojis: sí/no ─────────────────────────────────────────── */
      function aplicarEmojis() {
        var btn = document.getElementById("nx-emojis");
        if (!btn) return;
        var on = html.getAttribute("data-nx-emojis") !== "off";
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        btn.setAttribute("title", on ? "Emojis: sí (clic para quitarlos)" : "Emojis: no (clic para ponerlos)");
        var ico = btn.querySelector(".nx-note-tools__ico");
        if (ico) ico.textContent = on ? "☺" : "☻";
      }

      document.addEventListener("click", function (ev) {
        var t = ev.target;
        if (!(t instanceof Element)) return;
        if (t.closest("#nx-lectura")) {
          var activo = !html.classList.contains("nx-lectura");
          guardar(activo);
          aplicar();
          return;
        }
        if (t.closest("#nx-imprimir")) {
          window.print();
          return;
        }
        if (t.closest("#nx-emojis")) {
          var on = html.getAttribute("data-nx-emojis") !== "off";
          var nuevo = on ? "off" : "on";
          html.setAttribute("data-nx-emojis", nuevo);
          try { localStorage.setItem("nx-emojis", nuevo); } catch (e) {}
          aplicarEmojis();
        }
      });

      document.addEventListener("astro:page-load", function () {
        aplicar();
        aplicarEmojis();
      });
      aplicar();
      aplicarEmojis();
    })();
  </script>

  <script>
    /**
     * El markdown de cada nota empieza con un h1 que casi siempre repite el
     * título de la nota (538 de 823 notas: "🧩 Diseño de Software" sobre la
     * nota "Diseño de Software"). El plugin rehype-h1-demote lo baja a h2 y
     * lo marca para que no salga en el índice, pero el texto se seguía viendo
     * duplicado bajo el título de la página.
     *
     * Aquí se oculta SOLO cuando coincide con el título (sin tildes, sin
     * mayúsculas y sin el emoji inicial). Si el h1 del markdown dice otra
     * cosa, se conserva: ahí es un apartado más de la nota.
     */
    (function () {
      function normalizar(s) {
        return (s || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^\p{L}\p{N}]/gu, "")
          .trim();
      }

      function revisar() {
        var h1 = document.querySelector("article > h1");
        var md = document.querySelector(".note-prose .nx-h1-md");
        if (!h1 || !md) return;
        if (normalizar(md.textContent) === normalizar(h1.textContent)) {
          md.hidden = true;
        } else {
          md.hidden = false;
        }
      }

      document.addEventListener("astro:page-load", function () {
        setTimeout(revisar, 0);
      });
      revisar();
    })();
  </script>

  <script>
    /**
     * Aviso de "sección no encontrada".
     *
     * Un puntero de la lectura puede apuntar a una sección que no existe
     * (una de esas 12 anclas del vault que apuntan a un apartado que no
     * está en la nota). Antes, al hacer clic no pasaba nada: el navegador
     * se quedaba arriba y no había ni un indicio de qué había pasado. Ahora
     * se dice qué pasó y se ofrece el índice de la materia.
     */
    (function () {
      var matUrl = document.getElementById("nx-aviso-ancla")?.getAttribute("data-mat") || "";

      function revisar() {
        var h = location.hash || "";
        if (h.length < 2) return;
        var id = "";
        try {
          id = decodeURIComponent(h.slice(1));
        } catch (e) {
          id = h.slice(1);
        }
        if (!id) return;
        var existe = document.getElementById(id);
        if (!existe) {
          try {
            existe = document.querySelector('[id="' + CSS.escape(id) + '"]');
          } catch (e) {
            existe = null;
          }
        }
        var aviso = document.getElementById("nx-aviso-ancla");
        if (!aviso) return;
        if (existe) {
          aviso.hidden = true;
          return;
        }
        var et = aviso.querySelector("[data-nx-aviso-t]");
        if (et) et.textContent = id.replace(/-/g, " ");
        aviso.hidden = false;
      }

      document.addEventListener("astro:page-load", function () {
        setTimeout(revisar, 120);
      });
      document.addEventListener("hashchange", revisar);
      document.addEventListener("click", function (ev) {
        var t = ev.target;
        if (t instanceof Element && t.closest("[data-nx-aviso-cerrar]")) {
          var aviso = document.getElementById("nx-aviso-ancla");
          if (aviso) aviso.hidden = true;
        }
      });
      setTimeout(revisar, 400);
    })();
  </script>

  <div id="nx-aviso-ancla" class="nx-aviso-ancla" data-mat={matUrl} hidden>
    <p class="nx-aviso-ancla__t">
      No encontramos la sección <strong data-nx-aviso-t></strong> en esta nota.
    </p>
    <div class="nx-aviso-ancla__acc">
      <a href={matUrl}>Ver el índice de la materia</a>
      <button type="button" data-nx-aviso-cerrar aria-label="Cerrar el aviso">×</button>
    </div>
  </div>
</Base>
