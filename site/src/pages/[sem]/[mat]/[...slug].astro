---
import Base from "../../../layouts/Base.astro";
import Explorer from "../../../components/Explorer.astro";
import NoteToc from "../../../components/NoteToc.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import "../../../styles/content.css";
import "katex/dist/katex.min.css";
import vault from "../../../data/vault.json";

export function getStaticPaths() {
  return vault.semestres.flatMap((s) =>
    s.materias.flatMap((m) =>
      m.notas.map((n) => ({
        params: {
          sem: s.id,
          mat: m.id,
          slug: n.units?.length ? [...n.units, n.slug].join("/") : n.slug,
        },
      }))
    )
  );
}

const { sem, mat, slug } = Astro.params;
const semData = vault.semestres.find((s) => s.id === sem);
const matData = semData?.materias.find((m) => m.id === mat);
if (!matData) return Astro.redirect("/");
const file = `${sem}/${mat}/${slug ?? ""}`;
const note = matData.notas.find((n) => n.file === file);
if (!note) return Astro.redirect(`/${sem}/${mat}/`);

const mods = import.meta.glob("/notes-md/**/*.md");
const key = `/notes-md/${file}.md`;
const mod = mods[key];
if (!mod) return Astro.redirect(`/${sem}/${mat}/`);
const { Content } = await mod();

function fecha(ms) {
  return new Date(ms).toLocaleDateString("es-EC", { day: "numeric", month: "short", year: "numeric" }).toLowerCase();
}

const pretty = (s: string) =>
  s
    .replace(/-/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());

// secuencia de notas de la materia (para Anterior/Siguiente)
const notasOrdenadas = matData.notas
  .map((n) => ({ n, k: (n.units?.length ? n.units.join("/") : "") + "/" + n.slug }))
  .sort((a, b) => a.k.localeCompare(b.k, "es", { numeric: true }));
const iOrd = notasOrdenadas.findIndex((x) => x.n.file === note.file);
const prev = iOrd > 0 ? notasOrdenadas[iOrd - 1].n : null;
const next = iOrd < notasOrdenadas.length - 1 ? notasOrdenadas[iOrd + 1].n : null;
const noteUrl = (n) => `/${sem}/${mat}${n.units?.length ? "/" + n.units.join("/") : ""}/${n.slug}/`;

// Dónde estás dentro de la materia: "Unidad 3 › IV. Derivadas direccionales"
const unitPath = (note.units ?? []).map(pretty).join(" › ");
const matUrl = `/${sem}/${mat}/`;
---

<Base title={`${note.title} · ${matData.title} · Neonotes`} description={`Apuntes de ${note.title} · ${matData.title} · ${semData.title}`}>
  <div class="nx-aura" style="width:320px;height:320px;top:-90px;right:12%;opacity:.55"></div>

  <SiteHeader
    variant="nota"
    container="max-w-[1320px]"
    sticky
    showIndex
    crumbs={[
      { label: semData.title, href: `/${sem}/` },
      { label: matData.title, href: matUrl },
      { label: note.title },
    ]}
  />

  <main class="nx-with-explorer nx-note-layout mx-auto max-w-[1320px] gap-10 px-6 pt-8 pb-20">
    <Explorer semId={sem} matId={mat} currentUrl={`/${file}/`} />
    <article>
      {unitPath ? (
        <p class="nx-section-title">{unitPath}</p>
      ) : (
        <p class="nx-section-title">{semData.title} › {matData.title}</p>
      )}
      <h1 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">{note.title}</h1>
      <p class="mt-2 font-mono text-[11px] tracking-wider text-[var(--color-nexus-muted)]">ÚLTIMA EDICIÓN · {fecha(note.mtime)}</p>
      <div class="nx-bar mt-4 max-w-xs"></div>
      <div class="nx-note-tools">
        <button type="button" id="nx-lectura" class="nx-note-tools__btn" aria-pressed="false">
          <span class="nx-note-tools__ico" aria-hidden="true">◐</span> Modo lectura
        </button>
        <button type="button" id="nx-imprimir" class="nx-note-tools__btn">
          <span class="nx-note-tools__ico" aria-hidden="true">⎙</span> Imprimir / PDF
        </button>
      </div>
      <div class="note-prose mt-8">
        <Content />
      </div>

      <div class="mt-12 border-t border-[rgba(255,255,255,0.06)] pt-6">
        <div class="grid items-stretch gap-3 sm:grid-cols-3">
          {prev ? (
            <a
              href={noteUrl(prev)}
              class="nx-card group flex flex-col justify-center !py-4 px-4"
            >
              <span class="font-mono text-[10px] tracking-[0.2em] text-[var(--color-nexus-muted)]">← ANTERIOR</span>
              <span class="mt-1 text-sm font-semibold leading-snug text-white transition-colors group-hover:text-[var(--color-nexus-green)] line-clamp-2">{prev.title}</span>
            </a>
          ) : <span />}
          <a href={matUrl} class="nx-card group flex flex-col items-center justify-center !py-4 px-4 text-center">
            <span class="font-mono text-[10px] tracking-[0.2em] text-[var(--color-nexus-muted)]">MATERIA</span>
            <span class="mt-1 text-sm font-semibold text-white transition-colors group-hover:text-[var(--color-nexus-green)]">{matData.title}</span>
          </a>
          {next ? (
            <a
              href={noteUrl(next)}
              class="nx-card group flex flex-col justify-center items-end !py-4 px-4 text-right"
            >
              <span class="font-mono text-[10px] tracking-[0.2em] text-[var(--color-nexus-muted)]">SIGUIENTE →</span>
              <span class="mt-1 text-sm font-semibold leading-snug text-white transition-colors group-hover:text-[var(--color-nexus-green)] line-clamp-2">{next.title}</span>
            </a>
          ) : <span />}
        </div>
      </div>
    </article>

    <NoteToc
      unitPath={unitPath}
      matTitle={matData.title}
      matUrl={matUrl}
      prev={prev ? { title: prev.title, url: noteUrl(prev) } : null}
      next={next ? { title: next.title, url: noteUrl(next) } : null}
    />
  </main>

  <script>
    type NxPdfFrame = HTMLIFrameElement;

    function pdfFrameMap() {
      const w = window as any;
      if (!w.__nxPdfFrames) w.__nxPdfFrames = new Map<Window, NxPdfFrame>();
      return w.__nxPdfFrames as Map<Window, NxPdfFrame>;
    }

    function mountPdf(card: HTMLElement) {
      if (card.dataset.nxPdfMounted) return;
      card.dataset.nxPdfMounted = "1";
      const slot = card.querySelector(".nx-pdf-slot");
      const src = card.dataset.nxPdfSrc;
      if (!slot || !src) return;
      const frame = document.createElement("iframe");
      frame.className = "nx-pdf-frame";
      frame.src = src;
      frame.title = card.querySelector(".nx-pdf-name")?.textContent?.trim() || "Visor PDF";
      frame.setAttribute("referrerpolicy", "no-referrer");
      frame.setAttribute("allowfullscreen", "");
      frame.setAttribute("loading", "lazy");
      slot.appendChild(frame);
      pdfFrameMap().set(frame.contentWindow, frame);

      const more = document.createElement("div");
      more.className = "nx-pdf-more";
      slot.after(more);
      moreObserver().observe(more);

      const btn = card.querySelector("[data-nx-pdf-open]");
      if (btn instanceof HTMLButtonElement) {
        btn.textContent = "Abierto";
        btn.disabled = true;
      }
    }

    function moreObserver() {
      const w = window as any;
      if (!w.__nxPdfMoreObserver) {
        w.__nxPdfMoreObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const card = (entry.target as HTMLElement).closest<HTMLElement>(".nx-pdf");
              const frame = card?.querySelector<HTMLIFrameElement>("iframe.nx-pdf-frame");
              if (frame?.contentWindow) {
                frame.contentWindow.postMessage({ type: "nx-pdf-more" }, location.origin);
              }
            }
          },
          { rootMargin: "300px 0px" }
        );
      }
      return w.__nxPdfMoreObserver as IntersectionObserver;
    }

    function bindPdfMessages() {
      const w = window as any;
      if (w.__nxPdfMsgBound) return;
      w.__nxPdfMsgBound = true;
      window.addEventListener("message", (e) => {
        if (e.origin !== location.origin) return;
        const d = e.data || {};
        if (d.type !== "nx-pdf-height") return;
        const frame = pdfFrameMap().get(e.source as Window);
        if (!frame) return;
        const h = Math.max(420, Math.round(Number(d.h) || 0));
        frame.style.height = `${h}px`;
      });
    }

    function initPdfLazy() {
      bindPdfMessages();
      const cards = Array.from(document.querySelectorAll<HTMLElement>(".nx-pdf[data-nx-pdf-src]"));
      if (!cards.length) return;
      const w = window as any;
      if (!w.__nxPdfObserver) {
        w.__nxPdfObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              w.__nxPdfObserver.unobserve(entry.target);
              mountPdf(entry.target as HTMLElement);
            }
          },
          { rootMargin: "400px 0px" }
        );
      }
      const io = w.__nxPdfObserver as IntersectionObserver;
      for (const card of cards) {
        if (card.dataset.nxPdfLazyReady) continue;
        card.dataset.nxPdfLazyReady = "1";
        io.observe(card);
      }
      document.querySelectorAll<HTMLButtonElement>("[data-nx-pdf-open]").forEach((btn) => {
        if (btn.dataset.nxPdfBound) return;
        btn.dataset.nxPdfBound = "1";
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>(".nx-pdf");
          if (!card) return;
          io.unobserve(card);
          mountPdf(card);
        });
      });
    }

    function boot() {
      // Recuerda dónde quedaste: la portada lo muestra en "Continuar leyendo"
      try {
        const parts = document.title.split(" · ");
        localStorage.setItem("nx-last", JSON.stringify({
          title: parts[0] || "",
          mat: parts[1] || "",
          url: location.pathname,
          at: Date.now(),
        }));
      } catch {}
      initPdfLazy();
    }
    document.addEventListener("astro:page-load", boot);
    boot();
  </script>

  <script>
    /**
     * Modo lectura + impresión.
     *
     * · "Modo lectura": quita header, pie, explorador, índice y fondo, y deja
     *   la nota sola, con más cuerpo. La preferencia se guarda (localStorage)
     *   y se aplica en todas las notas.
     * · "Imprimir / PDF": abre el diálogo del navegador, que con la hoja de
     *   estilos de impresión saca la nota en blanco y negro, lista para
     *   guardarse como PDF. Es la respuesta al "¿tuviste el PDF?": ahora la
     *   nota también se puede llevar en PDF.
     */
    (function () {
      var KEY = "nx-lectura";
      var html = document.documentElement;

      function leer() {
        try { return localStorage.getItem(KEY) === "1"; } catch (e) { return false; }
      }
      function guardar(v) {
        try { localStorage.setItem(KEY, v ? "1" : "0"); } catch (e) {}
      }

      function aplicar() {
        var activo = leer();
        html.classList.toggle("nx-lectura", activo);
        var btn = document.getElementById("nx-lectura");
        if (btn) {
          btn.setAttribute("aria-pressed", activo ? "true" : "false");
          var ico = btn.querySelector(".nx-note-tools__ico");
          var txt = btn.childNodes[btn.childNodes.length - 1];
          if (txt && txt.nodeType === 3) txt.textContent = activo ? " Salir del modo lectura" : " Modo lectura";
        }
      }

      document.addEventListener("click", function (ev) {
        var t = ev.target;
        if (!(t instanceof Element)) return;
        if (t.closest("#nx-lectura")) {
          var activo = !html.classList.contains("nx-lectura");
          guardar(activo);
          aplicar();
          return;
        }
        if (t.closest("#nx-imprimir")) {
          window.print();
        }
      });

      document.addEventListener("astro:page-load", aplicar);
      aplicar();
    })();
  </script>
</Base>
