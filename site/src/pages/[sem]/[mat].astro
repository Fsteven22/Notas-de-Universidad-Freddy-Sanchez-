---
import Base from "../../layouts/Base.astro";
import Explorer from "../../components/Explorer.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import vault from "../../data/vault.json";

export function getStaticPaths() {
  return vault.semestres.flatMap((s) =>
    s.materias.map((m) => ({ params: { sem: s.id, mat: m.id } }))
  );
}

const { sem, mat } = Astro.params;
const semData = vault.semestres.find((s) => s.id === sem);
const data = semData?.materias.find((m) => m.id === mat);
if (!data) return Astro.redirect(`/${sem}/`);

const MENORES = new Set([
  "de", "del", "la", "las", "los", "y", "en", "para", "por", "a", "e", "al",
]);
const ROMANOS = /^[ivxlcdm]{1,5}$/i;

const pretty = (slug: string) =>
  slug
    .split("-")
    .map((w, i) => {
      if (!w) return w;
      if (ROMANOS.test(w)) return w.toUpperCase();
      if (i > 0 && MENORES.has(w.toLowerCase())) return w.toLowerCase();
      return w.charAt(0).toUpperCase() + w.slice(1);
    })
    .join(" ");

const palette = [
  { c: "var(--color-nexus-green)", soft: "rgba(0,255,136,0.08)" },
  { c: "var(--color-nexus-blue)", soft: "rgba(0,170,255,0.09)" },
  { c: "var(--color-nexus-purple)", soft: "rgba(170,102,255,0.09)" },
  { c: "var(--color-nexus-gold)", soft: "rgba(245,159,0,0.09)" },
  { c: "var(--color-nexus-pink)", soft: "rgba(255,68,170,0.09)" },
  { c: "var(--color-nexus-cyan)", soft: "rgba(0,221,187,0.08)" },
];
const accentOf = (i: number) => palette[i % palette.length];

function fecha(ms) {
  return new Date(ms).toLocaleDateString("es-EC", { day: "numeric", month: "short" }).toLowerCase();
}

// agrupar notas por ruta de unidades
const grupos = new Map();
for (const n of data.notas) {
  const key = n.units?.length ? n.units.join("/") : "";
  if (!grupos.has(key)) grupos.set(key, []);
  grupos.get(key).push(n);
}
const gruposOrden = [...grupos.entries()].sort((a, b) =>
  a[0].localeCompare(b[0], "es", { numeric: true })
);

// cada grupo es una "unidad": número de unidad + título legible
const unidades = gruposOrden.map(([key, notas], gi) => {
  const partes = key ? key.split("/") : [];
  const raiz = partes[0] ?? "";
  const mUnidad = raiz.match(/^unidad-(\d+)/i);
  const numero = mUnidad ? Number(mUnidad[1]) : null;
  const titulo = key
    ? partes.map(pretty).join(" › ")
    : "Índice de materia";
  const ultima = Math.max(...notas.map((n) => n.mtime ?? 0));
  return { key, notas, gi, numero, titulo, ultima, accent: accentOf(gi) };
});
---

<Base title={`${data.title} · ${semData.title} · Neonotes`}>
  <div class="nx-aura" style="width:360px;height:360px;top:-100px;left:20%;opacity:.7"></div>

  <SiteHeader
    variant="nivel"
    container="max-w-[1320px]"
    showHome
    crumbs={[
      { label: semData.title, href: `/${sem}/` },
      { label: data.title },
    ]}
  />

  <section class="mx-auto max-w-[1320px] px-6 pt-8 pb-16">
    <div class="nx-with-explorer">
      <Explorer semId={sem} matId={mat} currentUrl={`/${sem}/${mat}/`} />
      <div>
        <p class="nx-section-title nx-fade-up">{semData.title}</p>
        <h1 class="nx-fade-up mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">{data.title}</h1>
        <div class="nx-bar mt-5 max-w-xs"></div>

        {
          unidades.length > 1 && (
            <nav class="nx-chips mt-8" aria-label="Unidades de la materia">
              {unidades.map(
                (u) =>
                  u.key && (
                    <a
                      href={`#u-${u.gi}`}
                      class="nx-chip"
                      style={`--accent:${u.accent.c}; --accent-soft:${u.accent.soft}`}
                    >
                      {u.numero !== null ? `U${u.numero}` : pretty(u.titulo.split(" › ")[0])}
                      <span class="nx-chip-count">{u.notas.length}</span>
                    </a>
                  )
              )}
            </nav>
          )
        }

        <div class="mt-8 space-y-10">
          {
            unidades.map((u) => (
              <section
                id={`u-${u.gi}`}
                class="nx-unit"
                style={`--accent:${u.accent.c}; --accent-soft:${u.accent.soft}`}
              >
                <header class="nx-unit-head">
                  <div class="min-w-0">
                    {u.numero !== null && (
                      <p class="nx-unit-kicker">Unidad {u.numero}</p>
                    )}
                    <h2 class="nx-unit-title">{u.titulo}</h2>
                  </div>
                  <p class="nx-unit-meta">
                    {u.notas.length} nota{u.notas.length === 1 ? "" : "s"} · última {fecha(u.ultima)}
                  </p>
                </header>

                <ul class="nx-note-list">
                  {u.notas.map((n, i) => (
                    <li
                      data-nx-reveal
                      style={`--nx-reveal-delay:${Math.min(i * 45, 360)}ms`}
                    >
                      <a
                        href={`/${sem}/${mat}${n.units?.length ? "/" + n.units.join("/") : ""}/${n.slug}/`}
                        class="nx-note-row"
                      >
                        <span class="nx-note-title">{n.title}</span>
                        <span class="nx-note-date">{fecha(n.mtime)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        {
          data.pdfs?.length > 0 && (
            <section class="mt-14">
              <p class="nx-section-title mb-5">Material descargable</p>
              <ul class="space-y-2">
                {/* vault.json guarda el PDF como string o como { url, size }
                    según la materia: se normaliza el href. */}
                {data.pdfs.map((p) => (
                  <li>
                    <a
                      href={typeof p.url === "string" ? p.url : p.url?.url}
                      target="_blank"
                      class="flex items-center justify-between rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.025)] px-4 py-3 transition hover:border-[rgba(0,255,136,0.4)] hover:bg-[rgba(255,255,255,0.05)]"
                    >
                      <span class="text-sm text-[#e5e7eb]">{p.title}</span>
                      <span class="nx-badge">PDF</span>
                    </a>
                  </li>
                ))}
                <li>
                  <a
                    href={`/downloads/${sem}-${mat}.zip`}
                    class="flex items-center justify-between rounded-xl border border-[rgba(0,255,136,0.4)] bg-[rgba(0,255,136,0.08)] px-4 py-3 transition hover:bg-[rgba(0,255,136,0.12)]"
                    download
                  >
                    <span class="text-sm text-[#e5e7eb]">Todos los PDFs de esta materia</span>
                    <span class="nx-badge">ZIP</span>
                  </a>
                </li>
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </section>
</Base>
