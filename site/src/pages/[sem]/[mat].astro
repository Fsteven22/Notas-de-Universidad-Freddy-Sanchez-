---
import Base from "../../layouts/Base.astro";
import Explorer from "../../components/Explorer.astro";
import vault from "../../data/vault.json";

export function getStaticPaths() {
  return vault.semestres.flatMap((s) =>
    s.materias.map((m) => ({ params: { sem: s.id, mat: m.id } }))
  );
}

const { sem, mat } = Astro.params;
const semData = vault.semestres.find((s) => s.id === sem);
const data = semData?.materias.find((m) => m.id === mat);
if (!data) return Astro.redirect(`/${sem}/`);

const pretty = (slug) =>
  slug.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

const palette = [
  "var(--color-nexus-green)",
  "var(--color-nexus-blue)",
  "var(--color-nexus-purple)",
  "var(--color-nexus-gold)",
  "var(--color-nexus-pink)",
  "var(--color-nexus-cyan)",
];
const accentOf = (i) => palette[i % palette.length];

function fecha(ms) {
  return new Date(ms).toLocaleDateString("es-EC", { day: "numeric", month: "short" }).toLowerCase();
}

// agrupar notas por ruta de unidades
const grupos = new Map();
for (const n of data.notas) {
  const key = n.units?.length ? n.units.join("/") : "";
  if (!grupos.has(key)) grupos.set(key, []);
  grupos.get(key).push(n);
}
const gruposOrden = [...grupos.entries()].sort((a, b) =>
  a[0].localeCompare(b[0], "es", { numeric: true })
);
---

<Base title={`${data.title} · ${semData.title} · Neonotes`}>
  <div class="nx-aura" style="width:360px;height:360px;top:-100px;left:20%;opacity:.7"></div>

  <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href={`/${sem}/`} class="font-mono text-xs tracking-wider text-[var(--color-nexus-muted)] hover:text-[var(--color-nexus-green)]">← {semData.title.toUpperCase()}</a>
    <button class="nx-search-open nx-btn nx-btn-ghost" type="button">Buscar</button>
  </header>

  <section class="mx-auto max-w-[1440px] px-6 pt-8 pb-16">
    <div class="nx-with-explorer">
      <Explorer semId={sem} matId={mat} currentUrl={`/${sem}/${mat}/`} />
      <div>
    <p class="nx-section-title nx-fade-up">{semData.title}</p>
    <h1 class="nx-fade-up mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">{data.title}</h1>
    <div class="nx-bar mt-5 max-w-xs"></div>

    <div class="mt-10 space-y-10">
      {
        gruposOrden.map(([key, notas], gi) => (
          <section>
            {key && (
              <p class="nx-section-title mb-4">
                <span class="mr-2 inline-block h-2 w-2 rounded-sm" style={`background: ${accentOf(gi)}; vertical-align: 1px;`}></span>
                {key.split("/").map(pretty).join(" › ")}
              </p>
            )}
            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
              {notas.map((n, i) => (
                <a
                  href={`/${sem}/${mat}${n.units?.length ? "/" + n.units.join("/") : ""}/${n.slug}/`}
                  class="nx-card group relative block !py-4 transition-all hover:-translate-y-0.5"
                  style={`animation: nx-fade-up 0.5s cubic-bezier(0.22,1,0.36,1) ${gi * 90 + i * 45}ms both;`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <p class="text-sm font-semibold leading-snug text-white transition-colors group-hover:text-[var(--color-nexus-green)]">{n.title}</p>
                    <span class="shrink-0 font-mono text-xs opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100" style="color: var(--color-nexus-green);">→</span>
                  </div>
                  <p class="mt-2 font-mono text-[10px] text-[var(--color-nexus-muted)]">{fecha(n.mtime)}</p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    {
      data.pdfs?.length > 0 && (
        <section class="mt-14">
          <p class="nx-section-title mb-5">Material descargable</p>
          <ul class="space-y-2">
            {data.pdfs.map((p) => (
              <li>
                <a
                  href={p.url}
                  target="_blank"
                  class="flex items-center justify-between rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.025)] px-4 py-3 transition hover:border-[rgba(0,255,136,0.4)] hover:bg-[rgba(255,255,255,0.05)]"
                >
                  <span class="text-sm text-[#e5e7eb]">{p.title}</span>
                  <span class="nx-badge">PDF</span>
                </a>
              </li>
            ))}
            <li>
              <a
                href={`/downloads/${sem}-${mat}.zip`}
                class="flex items-center justify-between rounded-xl border border-[rgba(0,255,136,0.4)] bg-[rgba(0,255,136,0.08)] px-4 py-3 transition hover:bg-[rgba(0,255,136,0.12)]"
                download
              >
                <span class="text-sm text-[#e5e7eb]">Todos los PDFs de esta materia</span>
                <span class="nx-badge">ZIP</span>
              </a>
            </li>
          </ul>
        </section>
      )
    }
      </div>
    </div>
  </section>
</Base>
