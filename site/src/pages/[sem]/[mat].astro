---
import Base from "../../layouts/Base.astro";
import Explorer from "../../components/Explorer.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import vault from "../../data/vault.json";
import { flashcardsDeMateria } from "../../lib/flashcards.mjs";

export function getStaticPaths() {
  return vault.semestres.flatMap((s) =>
    s.materias.map((m) => ({ params: { sem: s.id, mat: m.id } }))
  );
}

const { sem, mat } = Astro.params;
const semData = vault.semestres.find((s) => s.id === sem);
const data = semData?.materias.find((m) => m.id === mat);
if (!data) return Astro.redirect(`/${sem}/`);

const MENORES = new Set([
  "de", "del", "la", "las", "los", "y", "en", "para", "por", "a", "e", "al",
]);
const ROMANOS = /^[ivxlcdm]{1,5}$/i;

const pretty = (slug: string) =>
  slug
    .split("-")
    .map((w, i) => {
      if (!w) return w;
      if (ROMANOS.test(w)) return w.toUpperCase();
      if (i > 0 && MENORES.has(w.toLowerCase())) return w.toLowerCase();
      return w.charAt(0).toUpperCase() + w.slice(1);
    })
    .join(" ");

function fecha(ms) {
  return new Date(ms).toLocaleDateString("es-EC", { day: "numeric", month: "short" }).toLowerCase();
}

/* ── Jerarquía de la materia ───────────────────────────────────────────
   El vault anida las notas así:  Unidad N - Título / Subsección / ...
   Antes se agrupaba por la ruta COMPLETA, así que una unidad con varias
   subcarpetas salía partida en varios grupos y los chips repetían la
   misma unidad (tres "U0" en Diseño de Software). Ahora se agrupa por
   la UNIDAD (la primera parte de la ruta) y las subrutas quedan dentro,
   en gris, como subtítulos. */
const PREFIJOS: Array<{ re: RegExp; kicker: (m: RegExpMatchArray) => string }> = [
  { re: /^unidad-(\d+)-?/i, kicker: (m) => `Unidad ${m[1]}` },
  { re: /^modulo-(\d+)-?/i, kicker: (m) => `Módulo ${m[1]}` },
  { re: /^modulo-(general)-?/i, kicker: (m) => `Módulo ${m[1]}` },
];

/** Separa "unidad-1-fundamentos-de-la-poo" en su etiqueta y su nombre. */
function descifrarRaiz(raiz: string) {
  for (const p of PREFIJOS) {
    const m = raiz.match(p.re);
    if (m) {
      return { kicker: p.kicker(m), titulo: pretty(raiz.replace(p.re, "")) };
    }
  }
  return { kicker: "", titulo: pretty(raiz) };
}

// agrupa por unidad conservando el orden original de las notas
const porUnidad = new Map<string, { sub: string; notas: any[]; orden: number }[]>();
for (const n of data.notas) {
  const units = n.units ?? [];
  const raiz = units[0] ?? "";
  const sub = units.slice(1).join("/");
  if (!porUnidad.has(raiz)) porUnidad.set(raiz, []);
  const subs = porUnidad.get(raiz)!;
  let bloque = subs.find((s) => s.sub === sub);
  if (!bloque) {
    bloque = { sub, notas: [], orden: units.join("/") };
    subs.push(bloque);
  }
  bloque.notas.push(n);
}

const unidades = [...porUnidad.entries()]
  .map(([raiz, subs], gi) => {
    const { kicker, titulo } = raiz
      ? descifrarRaiz(raiz)
      : { kicker: "", titulo: "General" };
    const mNum = raiz.match(/^unidad-(\d+)/i);
    const numero = mNum ? Number(mNum[1]) : null;
    const notas = subs.flatMap((s) => s.notas);
    // la fecha solo se escribe cuando cambia respecto de la nota anterior
    let fechaPrevia = "";
    const filas = notas.map((n) => {
      const f = fecha(n.mtime);
      const cambia = f !== fechaPrevia;
      fechaPrevia = f;
      return { n, fecha: cambia ? f : "", mtime: n.mtime };
    });
    return {
      gi,
      raiz,
      kicker,
      titulo,
      numero,
      filas,
      subs: subs.map((s) => ({
        ruta: s.sub ? s.sub.split("/").map(pretty).join(" › ") : "",
        notas: s.notas,
      })),
      total: notas.length,
      ultima: Math.max(...notas.map((n) => n.mtime ?? 0)),
    };
  })
  .sort((a, b) => a.raiz.localeCompare(b.raiz, "es", { numeric: true }));

// Tarjetas de repaso que ya trae esta materia en sus notas
const tarjetasMat = flashcardsDeMateria(data.id);
const nTarjetas = tarjetasMat.length;

/* La nota que se titula igual que la materia es su índice de contenido:
   repetir el título aquí solo duplicaba el encabezado de la página. */
const norm = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
const tituloMateria = norm(data.title);
const esIndice = (titulo: string) => norm(titulo) === tituloMateria;
---

<Base title={`${data.title} · ${semData.title} · Neonotes`}>
  <SiteHeader
    variant="nivel"
    container="max-w-[1320px]"
    showHome
    crumbs={[
      { label: semData.title, href: `/${sem}/` },
      { label: data.title },
    ]}
  />

  <section class="mx-auto max-w-[1320px] px-6 pt-8 pb-16">
    <div class="nx-with-explorer">
      <Explorer semId={sem} matId={mat} currentUrl={`/${sem}/${mat}/`} />
      <div>
        <p class="nx-section-title">{semData.title}</p>
        <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl">{data.title}</h1>

        {
          nTarjetas > 0 && (
            <a href={`/estudio/?mat=${data.id}`} class="nx-flash-cta">
              <span class="nx-flash-cta__n">{nTarjetas}</span>
              <span>
                tarjetas de repaso de esta materia
                <br />
                <span class="nx-flash-cta__hint">prepárate con ellas →</span>
              </span>
            </a>
          )
        }

        {
          unidades.length > 1 && (
            <nav class="nx-chips mt-8" aria-label="Unidades de la materia">
              {unidades.map(
                (u) =>
                  u.raiz && (
                    <a href={`#u-${u.gi}`} class="nx-chip">
                      {u.numero !== null ? `U${u.numero}` : u.titulo}
                      <span class="nx-chip-count">{u.total}</span>
                    </a>
                  )
              )}
            </nav>
          )
        }

        <div class="mt-8 space-y-10">
          {
            unidades.map((u) => (
              <section id={`u-${u.gi}`} class="nx-unit">
                <header class="nx-unit-head">
                  <div class="min-w-0">
                    {u.kicker && <p class="nx-unit-kicker">{u.kicker}</p>}
                    <h2 class="nx-unit-title">{u.titulo}</h2>
                  </div>
                  <p class="nx-unit-meta">
                    {u.total} nota{u.total === 1 ? "" : "s"} · última {fecha(u.ultima)}
                  </p>
                </header>

                {u.subs.map((s) => (
                  <div class="nx-unit-sub">
                    {s.ruta && <p class="nx-unit-subtitle">{s.ruta}</p>}
                    <ul class="nx-note-list">
                      {s.notas.map((n) => {
                        const fila = u.filas.find((f) => f.n === n)!;
                        const href = `/${sem}/${mat}${n.units?.length ? "/" + n.units.join("/") : ""}/${n.slug}/`;
                        return (
                          <li class="nx-note-item">
                            <a href={href} class="nx-note-row">
                              <span class="nx-note-title">
                                {esIndice(n.title) ? "Índice de la materia" : n.title}
                              </span>
                              {fila.fecha && <span class="nx-note-date">{fila.fecha}</span>}
                            </a>
                            <button
                              type="button"
                              class="nx-fav-star"
                              data-nx-fav
                              aria-pressed="false"
                              aria-label={`Guardar "${n.title}" en favoritos`}
                              data-url={href}
                              data-t={n.title}
                              data-m={mat}
                              data-mt={data.title}
                              data-s={sem}
                              title="Guardar en favoritos"
                            >
                              <span data-nx-fav-ico aria-hidden="true">☆</span>
                            </button>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </section>
            ))
          }
        </div>

        {
          data.pdfs?.length > 0 && (
            <section class="mt-14">
              <p class="nx-section-title mb-4">Material descargable</p>
              <ul class="nx-rows">
                {/* vault.json guarda el PDF como string o como { url, size }
                    según la materia: se normaliza el href. */}
                {data.pdfs.map((p) => (
                  <li>
                    <a
                      href={typeof p.url === "string" ? p.url : p.url?.url}
                      target="_blank"
                      class="nx-row"
                    >
                      <span class="nx-row-title">{p.title}</span>
                      <span class="nx-row-meta">PDF</span>
                    </a>
                  </li>
                ))}
                <li>
                  <a href={`/downloads/${sem}-${mat}.zip`} class="nx-row" download>
                    <span class="nx-row-title">Todos los PDFs de esta materia</span>
                    <span class="nx-row-meta">ZIP</span>
                  </a>
                </li>
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </section>
</Base>
