---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import vault from "../data/vault.json";

export function getStaticPaths() {
  return vault.semestres.map((s) => ({ params: { sem: s.id } }));
}

const { sem } = Astro.params;
const data = vault.semestres.find((s) => s.id === sem);
if (!data) return Astro.redirect("/");
---

<Base title={`${data.title} · Neonotes`}>
  <div class="nx-aura" style="width:360px;height:360px;top:-100px;left:20%;opacity:.7"></div>

  <SiteHeader variant="nivel" showHome crumbs={[{ label: data.title }]} />

  <section class="mx-auto max-w-6xl px-6 pt-8 pb-16">
    <p class="nx-section-title nx-fade-up">Semestre</p>
    <h1 class="nx-fade-up mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">{data.title}</h1>
    <div class="nx-bar mt-5 max-w-xs"></div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        data.materias.map((m, i) => (
          <a
            href={`/${sem}/${m.id}/`}
            class="nx-card group relative block"
            data-nx-reveal
            style={`--nx-reveal-delay:${Math.min(i * 55, 400)}ms`}
          >
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-lg font-bold text-white leading-snug">{m.title}</h2>
              <span
                class="shrink-0 font-mono text-xs opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
                style="color: var(--color-nexus-green);"
              >
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
