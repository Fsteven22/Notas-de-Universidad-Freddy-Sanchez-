---
/**
 * /mapa/ — el mapa de la carrera en 3D.
 *
 * La idea: mostrar la carrera como un recorrido. Cada SEMESTRE es una
 * constelación (un nodo grande en el centro con sus materias orbitando) y
 * las constelaciones se encadenan de izquierda a derecha: preuniversitario
 * → 1ro → 2do → 3ro. Así se ve de un vistazo cuánto hay en cada etapa y por
 * dónde se avanza.
 *
 * · Sin CDN: el Three.js es el del propio sitio (`/three.module.js`).
 * · Sin JavaScript: el mapa 2D de abajo (el mismo contenido, en columnas)
 *   es lo que se ve; el 3D lo sustituye cuando puede.
 * · Accesible: cada nodo es un enlace real, se puede llegar con el teclado
 *   y el lector de pantalla los lee como enlaces.
 */
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import vault from "../data/vault.json";

const COLORES: Record<string, string> = {
  "preuniversitario": "#aa66ff",
  "1er-semestre": "#00aaff",
  "2do-semestre": "#00ff88",
  "3er-semestre": "#f59f00",
};

const sems = vault.semestres.filter((s) => s.id !== "raiz");

const datos = {
  semestres: sems.map((s) => ({
    id: s.id,
    titulo: s.title,
    color: COLORES[s.id] ?? "#7dd3fc",
    url: `/${s.id}/`,
    materias: s.materias.map((m) => ({
      id: m.id,
      titulo: m.title,
      notas: m.total ?? m.notas.length,
      url: `/${s.id}/${m.id}/`,
    })),
  })),
};

const totalMaterias = datos.semestres.reduce((n, s) => n + s.materias.length, 0);
const totalNotas = datos.semestres.reduce(
  (n, s) => n + s.materias.reduce((m, x) => m + x.notas, 0),
  0
);
---

<Base
  title="Mapa de la carrera · Neonotes"
  description="La carrera de Ingeniería Computacional ESPOL, semestre por semestre"
>
  <SiteHeader variant="nivel" crumbs={[{ label: "Inicio", href: "/" }, { label: "Mapa" }]} />

  <section class="mx-auto max-w-6xl px-6 pt-10 pb-20">
    <p class="nx-section-title">Mapa de la carrera</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
      Todo el camino, de un vistazo
    </h1>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-[#e5e7eb]">
      {datos.semestres.length} etapas · {totalMaterias} materias · {totalNotas} notas. Cada esfera
      es una materia: pásale el cursor para ver de qué es y haz clic para abrirla.
    </p>

    <div class="nx-mapa" id="nx-mapa">
      {/* ── Escena 3D (la construye el script) ── */}
      <div class="nx-mapa__stage" id="nx-mapa-stage">
        <canvas id="nx-mapa-canvas" aria-hidden="true"></canvas>
        <div class="nx-mapa__labels" id="nx-mapa-labels"></div>
        <div class="nx-mapa__tip" id="nx-mapa-tip" hidden></div>
        <p class="nx-mapa__hint" id="nx-mapa-hint">
          Arrastra para girar · rueda para acercar · clic en una materia para abrirla
        </p>
      </div>

      {/* ── Versión 2D: se ve por defecto (si no hay JS o no hay WebGL) ── */}
      <div class="nx-mapa__2d" id="nx-mapa-2d">
        {
          datos.semestres.map((s) => (
            <section class="nx-mapa2d__sem" style={`--nx-c:${s.color}`}>
              <h2 class="nx-mapa2d__tit">
                <a href={s.url}>{s.titulo}</a>
              </h2>
              <ul class="nx-mapa2d__lista">
                {s.materias.map((m) => (
                  <li>
                    <a href={m.url}>{m.titulo}</a>
                    <span class="nx-mapa2d__n">{m.notas} notas</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    <ul class="nx-mapa__leyenda">
      {
        datos.semestres.map((s) => (
          <li style={`--nx-c:${s.color}`}>
            <span class="nx-mapa__leyenda-dot" aria-hidden="true" />
            {s.titulo}
          </li>
        ))
      }
    </ul>
  </section>

  <script is:inline type="application/json" id="nx-mapa-data" set:html={JSON.stringify(datos)}></script>

  <script is:inline type="module" data-astro-rerun>
    import * as THREE from "/three.module.js";

    (function () {
      // Si ya habia una escena (navegacion con el ClientRouter), se para
      // antes de montar la nueva: si no, quedan dos bucles pintando a la vez.
      if (window.__nxMapaStop) {
        try { window.__nxMapaStop(); } catch (e) {}
        window.__nxMapaStop = null;
      }

      function iniciar() {
      var datos = null;
      try {
        var crudo = document.getElementById("nx-mapa-data");
        datos = crudo ? JSON.parse(crudo.textContent || "{}") : null;
      } catch (e) {
        datos = null;
      }
      if (!datos || !datos.semestres || !datos.semestres.length) return;
      var root = document.getElementById("nx-mapa");
      if (!root || root.dataset.nxMapaListo === "1") return;

      var stage = document.getElementById("nx-mapa-stage");
      var canvas = document.getElementById("nx-mapa-canvas");
      var labelsEl = document.getElementById("nx-mapa-labels");
      var tip = document.getElementById("nx-mapa-tip");
      if (!root || !stage || !canvas || !labelsEl) return;

      function reducido() {
        var m = window.__nxMotion;
        if (m && typeof m.effective === "function") return !m.effective();
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      }

      // ── Escena ─────────────────────────────────────────────────────────
      var scene = new THREE.Scene();
      var camera = new THREE.PerspectiveCamera(45, 1, 0.1, 500);
      var renderer;
      try {
        renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
      } catch (e) {
        return; // sin WebGL se queda el mapa 2D
      }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      var grupo = new THREE.Group();
      scene.add(grupo);

      scene.add(new THREE.AmbientLight(0xffffff, 0.75));
      var luz = new THREE.PointLight(0xffffff, 1.1, 300);
      luz.position.set(0, 12, 24);
      scene.add(luz);

      // Disposición: los semestres van en el eje X (de izquierda a derecha el
      // avance de la carrera) y las materias orbitan alrededor de su hub.
      var X_SEM = 16;   // separación entre semestres
      var R = 6.2;      // radio de la órbita de materias
      var hubs = [];
      var nodos = [];   // { mesh, halo, datos, pos }
      var etiquetas = []; // { el, pos, sem }
      var lineas = [];

      function materialNodo(color, emisivo) {
        return new THREE.MeshStandardMaterial({
          color: color,
          roughness: 0.32,
          metalness: 0.12,
          emissive: color,
          emissiveIntensity: emisivo || 0.32,
        });
      }

      function etiquetaHTML(clase, texto, href, aria) {
        var el = document.createElement(href ? "a" : "span");
        el.className = clase;
        el.textContent = texto;
        if (href) el.setAttribute("href", href);
        if (aria) el.setAttribute("aria-label", aria);
        labelsEl.appendChild(el);
        return el;
      }

      datos.semestres.forEach(function (s, si) {
        var x = (si - (datos.semestres.length - 1) / 2) * X_SEM;
        var color = new THREE.Color(s.color);

        // Hub del semestre
        var hubGeo = new THREE.SphereGeometry(1.05, 28, 20);
        var hubMat = materialNodo(color, 0.45);
        var hub = new THREE.Mesh(hubGeo, hubMat);
        hub.position.set(x, 0, 0);
        grupo.add(hub);
        hubs.push({ mesh: hub, datos: s, pos: hub.position });

        var haloHub = new THREE.Mesh(
          new THREE.SphereGeometry(1.9, 20, 14),
          new THREE.MeshBasicMaterial({
            color: color,
            transparent: true,
            opacity: 0.11,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
          })
        );
        haloHub.position.copy(hub.position);
        grupo.add(haloHub);
        hubs[hubs.length - 1].halo = haloHub;

        var et = etiquetaHTML(
          "nx-mapa__label nx-mapa__label--sem",
          s.titulo.toUpperCase(),
          s.url,
          s.titulo + ": abrir el semestre"
        );
        et.style.setProperty("--nx-c", s.color);
        etiquetas.push({ el: et, pos: hub.position, sem: true });

        // Materias orbitando
        var M = s.materias.length;
        s.materias.forEach(function (m, mi) {
          var ang = (mi / M) * Math.PI * 2 - Math.PI / 2 + si * 0.35;
          var px = x + Math.cos(si * 0.6) * 1.2;
          var py = Math.sin(ang) * R;
          var pz = Math.cos(ang) * R;

          var geo = new THREE.SphereGeometry(0.62, 24, 16);
          var mat = materialNodo(color, 0.38);
          var mesh = new THREE.Mesh(geo, mat);
          mesh.position.set(px, py, pz);
          mesh.userData = { url: m.url, titulo: m.titulo, notas: m.notas, sem: s.titulo };
          grupo.add(mesh);

          var halo = new THREE.Mesh(
            new THREE.SphereGeometry(1.25, 16, 12),
            new THREE.MeshBasicMaterial({
              color: color,
              transparent: true,
              opacity: 0.13,
              blending: THREE.AdditiveBlending,
              depthWrite: false,
            })
          );
          halo.position.copy(mesh.position);
          grupo.add(halo);

          nodos.push({ mesh: mesh, halo: halo, datos: m, sem: s, pos: mesh.position });

          var el = etiquetaHTML(
            "nx-mapa__label",
            m.titulo,
            m.url,
            m.titulo + " (" + s.titulo + "): " + m.notas + " notas"
          );
          el.style.setProperty("--nx-c", s.color);
          etiquetas.push({ el: el, pos: mesh.position, sem: false });

          // Línea hub -> materia
          var g = new THREE.BufferGeometry().setFromPoints([
            hub.position.clone(),
            mesh.position.clone(),
          ]);
          var lm = new THREE.LineBasicMaterial({
            color: color,
            transparent: true,
            opacity: 0.4,
          });
          grupo.add(new THREE.Line(g, lm));
          lineas.push(lm);
        });
      });

      // Curvas que encadenan los semestres (el avance de la carrera)
      for (var i = 0; i < hubs.length - 1; i++) {
        var a = hubs[i].pos.clone();
        var b = hubs[i + 1].pos.clone();
        var medio = a.clone().lerp(b, 0.5);
        medio.z += 5.5; // se arquea hacia el espectador
        var curva = new THREE.QuadraticBezierCurve3(a, medio, b);
        var puntos = curva.getPoints(48);
        var g2 = new THREE.BufferGeometry().setFromPoints(puntos);
        var lm2 = new THREE.LineBasicMaterial({
          color: 0x9aa7ff,
          transparent: true,
          opacity: 0.3,
        });
        grupo.add(new THREE.Line(g2, lm2));
        lineas.push(lm2);
      }

      // ── Cámara y tamaño ───────────────────────────────────────────────
      var yaw = 0;
      var pitch = 0.12;
      var dist = 60;
      var distMin = 18;
      var distMax = 110;
      var W = 1;
      var H = 1;

      function anchoTotal() {
        return (datos.semestres.length - 1) * X_SEM + R * 2 + 6;
      }

      function ajustarDistancia() {
        var fovV = (camera.fov * Math.PI) / 180;
        var alto = R * 2 + 7;
        var distV = alto / 2 / Math.tan(fovV / 2);
        var fovH = 2 * Math.atan(Math.tan(fovV / 2) * camera.aspect);
        var distH = anchoTotal() / 2 / Math.tan(fovH / 2);
        return Math.max(distV, distH) * 1.14;
      }

      function redimensionar() {
        var r = stage.getBoundingClientRect();
        W = Math.max(320, r.width);
        H = Math.max(280, r.height);
        renderer.setSize(W, H, false);
        camera.aspect = W / H;
        camera.updateProjectionMatrix();
        if (!usuarioAjusto) dist = ajustarDistancia();
      }

      var usuarioAjusto = false;
      window.addEventListener("resize", redimensionar);
      redimensionar();

      function colocarCamara() {
        camera.position.set(
          Math.sin(yaw) * dist,
          pitch * dist * 0.55 + 2,
          Math.cos(yaw) * dist
        );
        camera.lookAt(0, 0, 0);
      }

      // ── Interacción ────────────────────────────────────────────────────
      var raycaster = new THREE.Raycaster();
      var mouse = new THREE.Vector2(-10, -10);
      var hover = null;
      var arrastrando = false;
      var ultimoX = 0;
      var ultimoY = 0;
      var ultimaInteraccion = Date.now();

      function raycast() {
        raycaster.setFromCamera(mouse, camera);
        var hits = raycaster.intersectObjects(
          nodos.map(function (n) { return n.mesh; }),
          false
        );
        return hits.length ? hits[0].object : null;
      }

      stage.addEventListener("mousemove", function (ev) {
        var r = stage.getBoundingClientRect();
        mouse.x = ((ev.clientX - r.left) / r.width) * 2 - 1;
        mouse.y = -((ev.clientY - r.top) / r.height) * 2 + 1;
        ultimaInteraccion = Date.now();
        if (arrastrando) {
          yaw += (ev.clientX - ultimoX) * 0.006;
          pitch += (ev.clientY - ultimoY) * 0.003;
          pitch = Math.max(-0.45, Math.min(0.6, pitch));
          ultimoX = ev.clientX;
          ultimoY = ev.clientY;
          usuarioAjusto = true;
          return;
        }
      });

      stage.addEventListener("mousedown", function (ev) {
        arrastrando = true;
        ultimoX = ev.clientX;
        ultimoY = ev.clientY;
        stage.classList.add("is-arrastrando");
      });

      window.addEventListener("mouseup", function () {
        arrastrando = false;
        stage.classList.remove("is-arrastrando");
      });

      stage.addEventListener("mouseleave", function () {
        mouse.set(-10, -10);
        hover = null;
        if (tip) tip.hidden = true;
      });

      stage.addEventListener("click", function () {
        if (!hover) return;
        var url = hover.userData && hover.userData.url;
        if (url) window.location.href = url;
      });

      stage.addEventListener(
        "wheel",
        function (ev) {
          ev.preventDefault();
          dist = Math.max(distMin, Math.min(distMax, dist + ev.deltaY * 0.05));
          usuarioAjusto = true;
          ultimaInteraccion = Date.now();
        },
        { passive: false }
      );

      // ── Bucle ──────────────────────────────────────────────────────────
      var reloj = new THREE.Timer();
      var proyectado = new THREE.Vector3();
      var activo = false;
      var animId = null;

      function proyectar(pos, el) {
        proyectado.copy(pos);
        grupo.localToWorld(proyectado);
        proyectado.project(camera);
        var visible = proyectado.z < 1;
        el.style.opacity = visible ? "1" : "0";
        el.style.pointerEvents = visible ? "auto" : "none";
        el.style.transform =
          "translate(-50%,-50%) translate(" +
          ((proyectado.x * 0.5 + 0.5) * W).toFixed(1) +
          "px," +
          ((-proyectado.y * 0.5 + 0.5) * H).toFixed(1) +
          "px)";
      }

      function frame() {
        animId = requestAnimationFrame(frame);
        reloj.update();
        var t = reloj.getElapsed();

        if (!reducido() && !arrastrando && Date.now() - ultimaInteraccion > 3200) {
          yaw += 0.0022;
        }

        colocarCamara();

        // pulso suave de las esferas (con reduced motion, quieto)
        var pulso = reducido() ? 0 : Math.sin(t * 1.6) * 0.05;
        for (var i = 0; i < nodos.length; i++) {
          var n = nodos[i];
          var esHover = hover === n.mesh;
          var escala = (esHover ? 1.45 : 1) + pulso;
          n.mesh.scale.setScalar(escala);
          n.halo.scale.setScalar(esHover ? 1.5 : 1 + pulso * 0.8);
          n.halo.material.opacity = esHover ? 0.3 : 0.13;
        }
        for (var j = 0; j < hubs.length; j++) {
          var h = hubs[j];
          h.mesh.scale.setScalar(1 + (reducido() ? 0 : Math.sin(t * 1.2 + j) * 0.04));
          h.halo.material.opacity = 0.11;
        }

        // hover por raycast (una vez por frame es barato con 18 nodos)
        if (!arrastrando) {
          var hit = raycast();
          if (hit !== hover) {
            hover = hit;
            stage.style.cursor = hit ? "pointer" : "grab";
            if (tip) {
              if (hit && hit.userData) {
                tip.hidden = false;
                tip.innerHTML =
                  "<strong>" +
                  hit.userData.titulo +
                  "</strong><span>" +
                  hit.userData.sem +
                  " · " +
                  hit.userData.notas +
                  " notas</span>";
              } else {
                tip.hidden = true;
              }
            }
          }
          if (tip && hover && hover.userData) {
            var r2 = stage.getBoundingClientRect();
            tip.style.transform =
              "translate(-50%,0) translate(" +
              (mouse.x * 0.5 + 0.5) * r2.width +
              "px," +
              (-mouse.y * 0.5 + 0.5) * r2.height +
              "px)";
          }
        }

        for (var k = 0; k < etiquetas.length; k++) {
          proyectar(etiquetas[k].pos, etiquetas[k].el);
        }

        renderer.render(scene, camera);
      }

      function arrancar() {
        if (activo) return;
        activo = true;
        root.classList.add("nx-mapa--3d");
        frame();
      }

      function parar() {
        activo = false;
        if (animId) cancelAnimationFrame(animId);
        animId = null;
      }

      // El ClientRouter puede volver a montar la pagina: el script inline se
      // re-ejecuta (data-astro-rerun), pero aun asi hay que arrancar y
      // parar con los eventos del router.
      document.addEventListener("astro:before-swap", parar);
      document.addEventListener("astro:page-load", arrancar);
      arrancar();

      // Red de seguridad: si el navegador no puede con WebGL, el mapa 2D
      // (que ya esta en el HTML) se queda visible.
      try {
        renderer.render(scene, camera);
      } catch (e) {
        parar();
        root.classList.remove("nx-mapa--3d");
      }
      root.dataset.nxMapaListo = "1";
      window.__nxMapaStop = function () {
        parar();
        root.dataset.nxMapaListo = "";
      };
      }

      // Un solo listener aunque el script se re-ejecute varias veces.
      if (window.__nxMapaHandler) {
        document.removeEventListener("astro:page-load", window.__nxMapaHandler);
      }
      window.__nxMapaHandler = iniciar;
      document.addEventListener("astro:page-load", iniciar);
      iniciar();
    })();
  </script>
</Base>
