---
/**
 * ThemeToggle.astro — el interruptor claro/oscuro.
 *
 * El sitio tiene dos temas (claro, el principal; oscuro, el alternativo).
 * Por defecto se sigue al sistema; cuando el lector elige, la elección se
 * guarda en localStorage ("theme") y se aplica al instante.
 *
 * El botón NO guarda la preferencia del sistema: si nadie ha elegido nada,
 * el sitio vuelve a seguir al sistema cuando cambia (de día a noche).
 */
---

<button
  type="button"
  class="nx-hbtn nx-hbtn--icon nx-theme-toggle"
  data-nx-theme-toggle
  aria-label="Cambiar de tema"
  title="Cambiar de tema"
>
  {/* El icono muestra la acción, no el estado: sol en oscuro, luna en claro. */}
  <svg
    class="nx-theme-ico nx-theme-ico--sol"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
  </svg>
  <svg
    class="nx-theme-ico nx-theme-ico--luna"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style is:global>
  .nx-theme-ico {
    width: 1rem;
    height: 1rem;
  }
  /* En claro se ofrece la luna (pasar a oscuro); en oscuro, el sol. */
  .nx-theme-ico--sol {
    display: none;
  }
  :root[data-theme="dark"] .nx-theme-ico--sol {
    display: block;
  }
  :root[data-theme="dark"] .nx-theme-ico--luna {
    display: none;
  }
</style>

<script>
  /**
   * Interruptor de tema.
   *
   * · el atributo data-theme lo pone el script del <head> (antes de pintar)
   * · al pulsar se invierte el tema actual y se guarda la elección
   * · si el lector no ha elegido nada, el sitio sigue al sistema: cuando
   *   el sistema cambia de claro a oscuro, el sitio también
   */
  const KEY = "theme";

  const oscuro = () => document.documentElement.getAttribute("data-theme") === "dark";

  /** El tema efectivo ahora mismo (el que está painted). */
  function tema(): "light" | "dark" {
    return oscuro() ? "dark" : "light";
  }

  /** Lo que el lector eligió, o null si sigue al sistema. */
  function eleccion(): string | null {
    try {
      const v = localStorage.getItem(KEY);
      return v === "light" || v === "dark" ? v : null;
    } catch {
      return null;
    }
  }

  function pintar(t: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", t);
    const meta = document.getElementById("nx-theme-color");
    if (meta) meta.setAttribute("content", t === "dark" ? "#0b1318" : "#f4f8fa");
    const etiqueta = t === "dark" ? "Cambiar a tema claro" : "Cambiar a tema oscuro";
    document.querySelectorAll("[data-nx-theme-toggle]").forEach((b) => {
      b.setAttribute("aria-label", etiqueta);
      b.setAttribute("title", etiqueta);
    });
  }

  /* Un solo delegated listener: el header se reconstruye en cada
     navegación, así que el botón no se puede guardar en una variable. */
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement | null;
    if (!t || typeof t.closest !== "function") return;
    if (!t.closest("[data-nx-theme-toggle]")) return;
    const nuevo = tema() === "dark" ? "light" : "dark";
    try {
      localStorage.setItem(KEY, nuevo);
    } catch {}
    pintar(nuevo);
  });

  /* Si el lector no ha elegido, el sitio sigue al sistema. */
  const mq = window.matchMedia("(prefers-color-scheme: dark)");
  const alCambiar = (e: MediaQueryListEvent) => {
    if (eleccion()) return;
    pintar(e.matches ? "dark" : "light");
  };
  if (mq.addEventListener) mq.addEventListener("change", alCambiar);
  else if (mq.addListener) mq.addListener(alCambiar);

  /* Las etiquetas del botón dependen del tema: se refrescan al navegar. */
  function etiquetar() {
    pintar(tema());
  }
  etiquetar();
  document.addEventListener("astro:page-load", etiquetar);
</script>
