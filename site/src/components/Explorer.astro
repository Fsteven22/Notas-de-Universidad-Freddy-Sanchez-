---
import vault from "../data/vault.json";

const { semId, matId, currentUrl } = Astro.props as {
  semId?: string;
  matId?: string;
  currentUrl?: string;
};

const esc = (s: any) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const isActive = (url: string) =>
  currentUrl ? currentUrl.replace(/\/$/, "") === url.replace(/\/$/, "") : false;

function noteUrl(sem: string, mat: string, units: string[], slug: string) {
  return `/${sem}/${mat}${units.length ? "/" + units.join("/") : ""}/${slug}/`;
}

function buildUnitsHtml(sem: string, mat: string, notas: any[]) {
  type Node = { kids: Map<string, Node>; notes: any[] };
  const root: Node = { kids: new Map(), notes: [] };
  for (const n of notas) {
    let node = root;
    for (const u of n.units ?? []) {
      if (!node.kids.has(u)) node.kids.set(u, { kids: new Map(), notes: [] });
      node = node.kids.get(u)!;
    }
    node.notes.push(n);
  }

  const render = (node: Node, prefix: string[]): string => {
    let out = "";
    for (const [u, child] of [...node.kids.entries()].sort((a, b) => a[0].localeCompare(b[0], "es", { numeric: true }))) {
      const label = u.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
      const detailsId = "nx-ex-" + [...prefix, u].join("-");
      out += `<details id="${detailsId}"><summary>${esc(label)}</summary>`;
      out += `<ul>${render(child, [...prefix, u])}`;
      // las notas raíz de este nodo van tras sus sub-unidades
      for (const n of child.notes) {
        const url = noteUrl(sem, mat, [...prefix, u], n.slug);
        const active = isActive(url) ? ' class="nx-ex-active"' : "";
        out += `<li><a href="${url}"${active}>${esc(n.title)}</a></li>`;
      }
      out += `</ul></details>`;
    }
    return out;
  };

  let html = "";
  for (const n of root.notes) {
    const url = noteUrl(sem, mat, [], n.slug);
    const active = isActive(url) ? ' class="nx-ex-active"' : "";
    html += `<li class="nx-ex-note"><a href="${url}"${active}>${esc(n.title)}</a></li>`;
  }
  html += render(root, []);
  return html;
}

let html = "";

for (const s of vault.semestres) {
  const isCurSem = semId === s.id || (!semId && false);
  html += `<details${isCurSem ? " open" : ""}>
    <summary class="nx-ex-sem">${esc(s.title)}</summary>
    <ul>`;
  for (const m of [...s.materias].sort((a, b) => a.title.localeCompare(b.title, "es"))) {
    const mUrl = `/${s.id}/${m.id}/`;
    const isCurrentMat = isCurSem && matId && m.id === matId;
    const active = isCurrentMat ? ' class="nx-ex-active"' : matId ? "" : isActive(mUrl) ? ' class="nx-ex-active"' : "";
    html += `<li>
      <a href="${mUrl}"${active}>${esc(m.title)}</a>`;
    if (isCurrentMat) {
      html += `<ul class="nx-ex-units">${buildUnitsHtml(s.id, m.id, m.notas)}</ul>`;
    }
    html += `</li>`;
  }
  html += `</ul></details>`;
}
---

<aside class="nx-explorer-wrap hidden xl:block">
  <div class="nx-explorer-filter">
    <input
      id="nx-explorer-filter"
      type="text"
      placeholder="Buscar notas…"
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <div class="nx-explorer" set:html={html} />
</aside>

<script>
  /** Buscador rápido del explorador: filtra notas y unidades al escribir. */
  const input = document.getElementById("nx-explorer-filter");
  const explorer = document.querySelector(".nx-explorer");
  if (input && explorer) {
    const cards = Array.from(explorer.querySelectorAll("li a, details summary"));
    input.addEventListener("input", () => {
      const term = input.value.toLowerCase().trim();
      for (const card of cards) {
        const text = card.textContent.toLowerCase();
        const li = card.closest("li");
        if (term === "") {
          li?.classList.remove("nx-ex-hidden");
          card.closest("details")?.open;
          continue;
        }
        const match = text.includes(term);
        li?.classList.toggle("nx-ex-hidden", !match);
        // si hay coincidencia dentro de un details cerrado, lo abrimos
        if (match) {
          const details = card.closest("details");
          if (details && !details.open) details.open = true;
        }
      }
    });
  }

  /** Recordar estado abierto/cerrado de cada <details> entre cambios de página. */
  document.querySelectorAll("details").forEach((details) => {
    const saved = localStorage.getItem(details.id);
    if (saved === "open") details.open = true;
    if (saved === "closed") details.open = false;
    details.addEventListener("toggle", () => {
      localStorage.setItem(details.id, details.open ? "open" : "closed");
    });
  });
</script>

<style>
  .nx-explorer-filter {
    margin-bottom: 0.6rem;
  }
  .nx-explorer-filter input {
    width: 100%;
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: #e5e7eb;
    font-family: var(--font-mono);
    font-size: 11px;
    box-sizing: border-box;
  }
  .nx-explorer-filter input::placeholder {
    color: var(--color-nexus-muted);
  }
  .nx-ex-hidden {
    display: none !important;
  }
</style>
