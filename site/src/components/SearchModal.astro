---
import MotionToggle from "./MotionToggle.astro";

/**
 * SearchModal.astro — el buscador.
 *
 * Antes el índice (public/search-index.json) solo guardaba por nota el
 * TÍTULO, la materia y el semestre: buscar "gradiente" solo encontraba notas
 * que se llamaran "Gradiente" y buscar "teorema de Rolle" no encontraba nada
 * aunque estuviera escrito en tres notas. El buscador era casi inútil.
 *
 * Ahora hay dos índices:
 *   · search-index.json (186 KB, títulos) → se carga al instante
 *   · search-content.json (apartados + fragmento de texto, ~2 MB) → se pide
 *     en segundo plano la primera vez que se abre el buscador
 *
 * Con el segundo, un resultado dice en qué apartado apareció y lleva al ancla
 * exacta, no al principio de la nota. Si estás dentro de una materia, sus
 * resultados salen primero.
 */
interface Props {
  /** semestre/materia de la página actual: sus resultados salen primero */
  scope?: string;
}
const { scope = "" } = Astro.props;
---

<div
  id="nx-search"
  class="nx-overlay fixed inset-0 z-50 hidden items-start justify-center px-4 pt-[11vh]"
  data-nx-scope={scope}
>
  <div id="nx-search-panel" class="w-full max-w-xl">
    <div class="relative overflow-hidden rounded border border-[var(--nx-line)] bg-[var(--nx-surface)]">

      <div class="flex items-center gap-3 border-b border-[var(--nx-line)] px-4 py-3.5">
        <svg class="size-4 shrink-0 text-[var(--nx-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <input
          id="nx-search-input"
          type="text"
          placeholder="Buscar en títulos y dentro de las notas…"
          autocomplete="off"
          spellcheck="false"
          class="w-full bg-transparent text-sm text-[var(--nx-text)] placeholder:text-[var(--nx-muted)] focus:outline-none"
        />
        <button
          id="nx-search-close"
          type="button"
          aria-label="Cerrar búsqueda"
          class="flex size-7 shrink-0 items-center justify-center rounded border border-[var(--nx-line)] text-[var(--nx-muted)] transition hover:border-[var(--nx-line-strong)] hover:text-[var(--nx-text)]"
        >
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      {/* Filtros por semestre y materia: el buscador ya traía los
          resultados de la materia actual primero ("scope"), pero no había
          forma de quedarse solo con un semestre o con una materia. */}
      <div
        id="nx-search-filters"
        class="hidden items-center gap-2 border-b border-[var(--nx-line)] px-4 py-2"
      >
        <span class="nx-search-sel-wrap">
          <select id="nx-search-sem" class="nx-search-sel" aria-label="Filtrar por semestre">
            <option value="">Todos los semestres</option>
          </select>
        </span>
        <span class="nx-search-sel-wrap">
          <select id="nx-search-mat" class="nx-search-sel" aria-label="Filtrar por materia">
            <option value="">Todas las materias</option>
          </select>
        </span>
        <button
          id="nx-search-clear"
          type="button"
          class="ml-auto shrink-0 text-[var(--nx-muted)] transition hover:text-[var(--nx-text)]"
        >
          Quitar filtros
        </button>
      </div>

      <div id="nx-search-list" class="max-h-[52vh] min-h-[180px] overflow-y-auto p-2 nx-scroll"></div>

      <div id="nx-search-foot" class="flex items-center justify-between gap-3 border-t border-[var(--nx-line)] px-4 py-2 text-[var(--nx-muted)]">
        <span id="nx-search-count"></span>
        <span class="flex items-center gap-3">
          <span class="hidden sm:inline"><span class="nx-search-key">↑↓</span> elegir</span>
          <span class="hidden sm:inline"><span class="nx-search-key">enter</span> ir</span>
          <MotionToggle variant="compact" />
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  /* La flecha del desplegable se dibuja con CSS (un triángulo con bordes)
     en vez de un SVG incrustado: así toma el color del tema y no lleva
     un verde horneado dentro de un data URI. */
  .nx-search-sel-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .nx-search-sel-wrap::after {
    content: "";
    position: absolute;
    right: 12px;
    top: 50%;
    margin-top: -2px;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--nx-muted);
    pointer-events: none;
  }
  .nx-search-sel {
    appearance: none;
    background: var(--nx-bg-soft);
    border: 1px solid var(--nx-line);
    border-radius: var(--nx-radius);
    color: var(--nx-dim);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    padding: 0.3rem 1.6rem 0.3rem 0.55rem;
    max-width: 11rem;
    cursor: pointer;
  }
  .nx-search-sel:focus-visible {
    outline: 2px solid var(--nx-neon);
    outline-offset: 1px;
  }
  .nx-search-sel option {
    background: var(--nx-surface);
    color: var(--nx-text);
  }
  /* Búsquedas recientes */
  #nx-search-list .nx-hist {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    text-align: left;
    padding: 0.45rem 0.6rem;
    border-radius: var(--nx-radius);
    color: var(--nx-dim);
    font-size: 13px;
    transition: background 0.14s ease, color 0.14s ease;
  }
  #nx-search-list .nx-hist:hover {
    background: var(--nx-surface-hover);
    color: var(--nx-text);
  }
  #nx-search-list .nx-hist span {
    color: var(--nx-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
</style>

<script>
  type Hit = {
    t: string;
    m: string;
    s: string;
    u: string;
    mt?: number;
    sec?: string;
    anchor?: string;
    snip?: string;
    sc?: number;
  };
  type Sec = { n: number; a: string; t: string; x: string };
  type SecIdx = Sec & { nt: string; nx: string };
  type ContentNote = { u: string; t: string; m: string; s: string; sec: Sec[] };
  type ContentNoteIdx = { u: string; t: string; m: string; s: string; sec: SecIdx[] };

  let idx: Hit[] = [];
  let loaded = false;
  let contentIdx: ContentNoteIdx[] = [];
  let contentLoaded = false;
  let hits: Hit[] = [];
  let selected = -1;
  /** semestre/materia de la página actual (lo pone data-nx-scope) */
  let scope = "";
  /** filtros del buscador */
  let filtroSem = "";
  let filtroMat = "";
  /** historial de búsquedas (localStorage) */
  const KEY_HIST = "nx-busq-historial";
  let historial: string[] = [];
  try {
    const h = JSON.parse(localStorage.getItem(KEY_HIST) || "[]");
    historial = Array.isArray(h) ? h.filter((x) => typeof x === "string") : [];
  } catch (e) {
    historial = [];
  }

  function guardarHistorial(q: string) {
    const limpio = q.trim();
    if (!limpio) return;
    historial = [limpio, ...historial.filter((x) => x !== limpio)].slice(0, 8);
    try {
      localStorage.setItem(KEY_HIST, JSON.stringify(historial));
    } catch (e) {
      /* sin almacenamiento: el historial es solo de esta visita */
    }
  }
  let ctx: {
    overlay: HTMLElement;
    input: HTMLInputElement;
    listEl: HTMLElement;
    countEl: HTMLElement;
  } | null = null;

  const AMP = String.fromCharCode(38);
  const LT = String.fromCharCode(60);
  const GT = String.fromCharCode(62);
  const QUOT = String.fromCharCode(34);

  const norm = (s: string) =>
    s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

  async function ensureIndex() {
    if (loaded) return;
    try {
      const res = await fetch("/search-index.json");
      idx = await res.json();
    } catch {
      idx = [];
    }
    loaded = true;
  }

  /** índice de contenido: se pide en segundo plano la primera vez */
  async function ensureContentIndex() {
    if (contentLoaded) return;
    try {
      const res = await fetch("/search-content.json");
      if (!res.ok) throw new Error("http " + res.status);
      const crudo: ContentNote[] = await res.json();
      // el texto se normaliza UNA sola vez: hay 18.043 apartados y
      // normalizar sus 280 caracteres en cada pulsacion era lo mas lento
      contentIdx = crudo.map((nota) => ({
        u: nota.u,
        t: nota.t,
        m: nota.m,
        s: nota.s,
        sec: nota.sec.map((s) => ({ ...s, nt: norm(s.t), nx: norm(s.x) })),
      }));
    } catch {
      contentIdx = [];
    }
    contentLoaded = true;
    if (ctx && !ctx.overlay.classList.contains("hidden")) {
      render(ctx.input.value);
    }
  }

  const esc = (s: string) =>
    s.replace(/&/g, AMP).replace(/</g, LT).replace(/>/g, GT).replace(/"/g, QUOT);

  const mapa = { a: "aáàäâã", e: "eéèëê", i: "iíìïî", o: "oóòöô", u: "uúùüû", n: "nñ", c: "cç" } as Record<string, string>;
  function accentRe(terms: string[]) {
    const parts = terms.map((t) =>
      t.split("").map((ch) => (mapa[ch] ? `[${mapa[ch]}]` : `[${ch.replace(/[.*+?^${}()\\[\]]/g, "\\$&")}]`)).join("")
    );
    return new RegExp(`(${parts.join("|")})`, "gi");
  }

  function highlight(text: string, terms: string[]) {
    if (!terms.length) return esc(text);
    try {
      return esc(text).replace(accentRe(terms), (m) =>
        m.includes("nx-search-mark") ? m : `<mark class="nx-search-mark">${m}</mark>`
      );
    } catch {
      return esc(text);
    }
  }

  /** puntúa una nota por su título */
  function score(n: Hit, terms: string[]) {
    const ht = norm(n.t), hm = norm(n.m), hs = norm(n.s);
    const words = ht.split(/\s+/);
    let sc = 0;
    for (const w of terms) {
      // cada palabra tiene que aparecer en algun sitio: si no, la nota no vale
      let s = 0;
      if (ht.startsWith(w)) s += 6;
      else if (ht.includes(w)) s += 4;
      if (words.some((x) => x.startsWith(w))) s += 3;
      if (hm.includes(w)) s += 1;
      if (hs.includes(w)) s += 0.5;
      if (s === 0) return 0;
      sc += s;
    }
    return sc;
  }

  /** ¿es de la materia que estoy viendo? */
  function enAlcance(u: string) {
    return !!scope && u.startsWith("/" + scope + "/");
  }

  /** busca dentro de los apartados: título del apartado + fragmento */
  function buscarApartados(terms: string[]) {
    const porNota = new Map<string, Hit[]>();
    for (const nota of contentIdx) {
      for (const sec of nota.sec) {
        let sc = 0;
        let ok = true;
        for (const w of terms) {
          let s = 0;
          if (sec.nt.startsWith(w)) s += 6;
          else if (sec.nt.includes(w)) s += 5;
          if (sec.nx.includes(w)) s += 1.5;
          if (s === 0) {
            ok = false;
            break;
          }
          sc += s;
        }
        if (!ok) continue;
        if (enAlcance(nota.u)) sc += 2.5;
        const arr = porNota.get(nota.u) || [];
        arr.push({
          t: nota.t,
          m: nota.m,
          s: nota.s,
          u: nota.u,
          sec: sec.t,
          anchor: sec.a,
          snip: sec.x,
          sc,
        });
        porNota.set(nota.u, arr);
      }
    }
    const out: Hit[] = [];
    for (const arr of porNota.values()) {
      arr.sort((a, b) => (b.sc ?? 0) - (a.sc ?? 0));
      // como mucho 2 apartados de la misma nota: si no, se ahoga la lista
      for (const h of arr.slice(0, 2)) out.push(h);
    }
    return out;
  }

  function hitHtml(n: Hit, terms: string[], i: number, recent = false) {
    const url = n.anchor ? `${n.u}#${n.anchor}` : n.u;
    return `
      <button type="button" data-i="${i}" data-url="${esc(url)}" style="animation-delay:${i * 28}ms" class="nx-hit${i === 0 ? " is-selected" : ""}">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-semibold leading-snug text-[var(--nx-text)]">${recent ? esc(n.t) : highlight(n.t, terms)}</p>
            ${
              n.sec
                ? `<p class="mt-1 text-[12.5px] leading-snug text-[var(--nx-dim)]">↳ ${highlight(n.sec, terms)}</p>`
                : ""
            }
            ${
              n.snip
                ? `<p class="mt-1 text-[12px] leading-snug text-[var(--nx-muted)]">${highlight(n.snip, terms)}</p>`
                : ""
            }
            <p class="mt-1.5 flex items-center gap-1.5 text-[var(--nx-muted)] truncate">
              <span class="mt-1.5 size-1.5 shrink-0 rounded-full ${recent ? "bg-[var(--nx-accent)] opacity-70" : "bg-[var(--nx-muted)] opacity-50"}"></span>
              ${esc(n.s)} · ${esc(n.m)}
            </p>
          </div>
          <span class="nx-hit-arrow mt-0.5 shrink-0 text-xs text-[var(--nx-accent)]">→</span>
        </div>
      </button>`;
  }

  function render(query: string) {
    if (!ctx) return;
    const terms = norm(query).trim().split(/\s+/).filter(Boolean);
    mostrarFiltros(terms.length > 0 || !!filtroSem || !!filtroMat);

    if (!terms.length) {
      // con un filtro puesto, "RECIENTES" también se filtra: si no, el
      // desplegable dice "1er Semestre" y la lista enseña otras materias
      const recent = [...idx]
        .filter((n) => (!filtroSem || n.s === filtroSem) && (!filtroMat || n.m === filtroMat))
        .sort((a, b) => (b.mt ?? 0) - (a.mt ?? 0))
        .slice(0, 6);
      hits = recent;
      const histHtml = historial.length
        ? `<p class="px-2 pb-1.5 pt-1 text-[var(--nx-muted)]">TUS BÚSQUEDAS</p>` +
          historial
            .map(
              (q) =>
                `<button type="button" class="nx-hist" data-q="${esc(q)}"><span>↺</span>${esc(q)}</button>`
            )
            .join("")
        : "";
      ctx.listEl.innerHTML =
        histHtml +
        `<p class="px-2 pb-1.5 pt-1 text-[var(--nx-muted)]">RECIENTES</p>` +
        recent.map((n, i) => hitHtml(n, [], i, true)).join("");
      ctx.countEl.textContent = idx.length ? `${idx.length} NOTAS INDEXADAS` : "";
      selected = 0;
      return;
    }

    const encontrados: Hit[] = [];

    // 1) coincidencias en el título de la nota
    for (const n of idx) {
      const sc = score(n, terms);
      if (sc <= 0) continue;
      let s = sc + 3;
      if (enAlcance(n.u)) s += 2.5;
      encontrados.push({ ...n, sc: s });
    }

    // 2) coincidencias dentro de los apartados
    if (contentIdx.length) {
      for (const h of buscarApartados(terms)) encontrados.push(h);
    }

    hits = encontrados
      .sort((a, b) => (b.sc ?? 0) - (a.sc ?? 0) || a.t.localeCompare(b.t, "es"));

    // Filtros por semestre y materia (se aplican antes de recortar: así el
    // filtro también afecta a los resultados de dentro de las notas y no se
    // quedan fuera los que estaban por debajo del corte).
    const filtrados = hits.filter((h) => {
      if (filtroSem && h.s !== filtroSem) return false;
      if (filtroMat && h.m !== filtroMat) return false;
      return true;
    });
    const habiaResultados = hits.length > 0;
    hits = filtrados.slice(0, 15);

    if (!hits.length) {
      selected = -1;
      const porFiltro = habiaResultados && (filtroSem || filtroMat);
      ctx.listEl.innerHTML = `
        <div class="flex flex-col items-center justify-center px-4 py-10 text-center">
          <svg class="size-8 text-[var(--nx-line-strong)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>
          <p class="mt-3 text-sm text-[var(--nx-dim)]">${
            porFiltro
              ? "Sin resultados con ese filtro"
              : `Sin resultados para <span class="text-[var(--nx-text)]">"${esc(query.trim())}"</span>`
          }</p>
          ${
            porFiltro
              ? `<button type="button" class="nx-hist mt-2" data-clear-filters>Quitar los filtros y ver todo</button>`
              : `<p class="mt-1 text-[var(--nx-muted)]">PRUEBA CON MENOS PALABRAS</p>`
          }
        </div>`;
      ctx.countEl.textContent = porFiltro
        ? "0 COINCIDENCIAS CON EL FILTRO"
        : "0 COINCIDENCIAS";
      return;
    }

    const cargando =
      terms.length && !contentLoaded
        ? `<p class="px-2 py-2 text-[var(--nx-muted)]">BUSCANDO TAMBIÉN DENTRO DE LAS NOTAS…</p>`
        : "";

    ctx.listEl.innerHTML = hits.map((n, i) => hitHtml(n, terms, i)).join("") + cargando;
    ctx.countEl.textContent = `${hits.length} COINCIDENCIA${hits.length === 1 ? "" : "S"}`;
    selected = 0;
  }

  function updateSelected() {
    if (!ctx) return;
    ctx.listEl.querySelectorAll(".nx-hit").forEach((el, i) => {
      el.classList.toggle("is-selected", i === selected);
    });
    (ctx.listEl.querySelector(".nx-hit.is-selected") as HTMLElement | null)?.scrollIntoView({ block: "nearest" });
  }

  /* ── Filtros por semestre y materia ─────────────────────────────────── */

  const selSem = () => document.getElementById("nx-search-sem") as HTMLSelectElement | null;
  const selMat = () => document.getElementById("nx-search-mat") as HTMLSelectElement | null;

  /** Rellena los desplegables con lo que hay en el índice. */
  function poblarFiltros() {
    const s = selSem();
    const m = selMat();
    if (!s || !m || !idx.length) return;

    const semestres = [...new Set(idx.map((n) => n.s).filter(Boolean))].sort((a, b) =>
      a.localeCompare(b, "es", { numeric: true })
    );
    s.innerHTML =
      `<option value="">Todos los semestres</option>` +
      semestres.map((x) => `<option value="${esc(x)}">${esc(x)}</option>`).join("");
    s.value = filtroSem;

    const materias = [...new Set(idx.filter((n) => !filtroSem || n.s === filtroSem).map((n) => n.m).filter(Boolean))]
      .sort((a, b) => a.localeCompare(b, "es"));
    m.innerHTML =
      `<option value="">Todas las materias</option>` +
      materias.map((x) => `<option value="${esc(x)}">${esc(x)}</option>`).join("");
    m.value = filtroMat;
  }

  /** La fila de filtros solo se muestra cuando hay algo que filtrar. */
  function mostrarFiltros(visible: boolean) {
    const f = document.getElementById("nx-search-filters");
    if (!f) return;
    f.classList.toggle("hidden", !visible);
    f.classList.toggle("flex", visible);
  }

  function limpiarFiltros() {
    filtroSem = "";
    filtroMat = "";
    const s = selSem();
    const m = selMat();
    if (s) s.value = "";
    if (m) m.value = "";
    poblarFiltros();
    if (ctx) render(ctx.input.value);
  }

  function openSearch() {
    if (!ctx) return;
    ctx.overlay.classList.remove("hidden");
    ctx.overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
    ctx.input.value = "";
    render("");
    // Se fuerza un reflow para que el navegador registre el estado inicial
    // (opacity 0) antes de aplicar "nx-open": así la entrada animada no
    // depende de requestAnimationFrame, que no se dispara si la pestaña
    // está en segundo plano (el panel se quedaría invisible y sin foco).
    void ctx.overlay.offsetWidth;
    ctx.overlay.classList.add("nx-open");
    ctx.input.focus();
    // el índice de contenido se pide en segundo plano
    void ensureContentIndex();
  }

  function closeSearch() {
    if (!ctx) return;
    const { overlay, listEl } = ctx;
    overlay.classList.remove("nx-open");
    setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.body.style.overflow = "";
      while (listEl.firstChild) listEl.removeChild(listEl.firstChild);
      hits = [];
      selected = -1;
    }, 160);
  }

  const isOpen = () => !!ctx && (ctx.overlay.classList.contains("nx-open") || !ctx.overlay.classList.contains("hidden"));

  function bind() {
    const overlay = document.getElementById("nx-search");
    const input = document.getElementById("nx-search-input") as HTMLInputElement | null;
    if (!overlay || !input || overlay.dataset.nxBound) return;
    overlay.dataset.nxBound = "1";
    scope = overlay.dataset.nxScope || "";
    const listEl = document.getElementById("nx-search-list")!;
    const countEl = document.getElementById("nx-search-count")!;
    const closeBtn = document.getElementById("nx-search-close")!;
    ctx = { overlay, input, listEl, countEl };

    closeBtn.addEventListener("click", closeSearch);
    // 18.043 apartados por pulsacion: se espera a que dejes de escribir
    let timer: number | undefined;
    input.addEventListener("input", () => {
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(() => render(input.value), 110);
    });
    overlay.addEventListener("mousedown", (e) => {
      if (e.target === overlay) closeSearch();
    });
    listEl.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      // búsqueda del historial: se vuelve a escribir y se busca
      const hist = t.closest(".nx-hist[data-q]") as HTMLElement | null;
      if (hist?.dataset.q) {
        input.value = hist.dataset.q;
        render(hist.dataset.q);
        input.focus();
        return;
      }
      // quitar los filtros desde el mensaje de "sin resultados"
      if (t.closest("[data-clear-filters]")) {
        limpiarFiltros();
        return;
      }
      const btn = t.closest(".nx-hit") as HTMLElement | null;
      if (btn?.dataset.url) {
        guardarHistorial(input.value);
        location.href = btn.dataset.url;
      }
    });

    // Filtros
    const s = selSem();
    const m = selMat();
    if (s && !s.dataset.nxBound) {
      s.dataset.nxBound = "1";
      s.addEventListener("change", () => {
        filtroSem = s.value;
        // la lista de materias depende del semestre elegido
        const materiaAntes = filtroMat;
        filtroMat = "";
        poblarFiltros();
        const mm = selMat();
        if (mm && materiaAntes && [...mm.options].some((o) => o.value === materiaAntes)) {
          mm.value = materiaAntes;
          filtroMat = materiaAntes;
        }
        render(input.value);
      });
    }
    if (m && !m.dataset.nxBound) {
      m.dataset.nxBound = "1";
      m.addEventListener("change", () => {
        filtroMat = m.value;
        render(input.value);
      });
    }
    const clear = document.getElementById("nx-search-clear");
    if (clear && !clear.dataset.nxBound) {
      clear.dataset.nxBound = "1";
      clear.addEventListener("click", limpiarFiltros);
    }
    document.querySelectorAll<HTMLElement>(".nx-search-open").forEach((b) => {
      if (b.dataset.nxSearchBound) return;
      b.dataset.nxSearchBound = "1";
      b.addEventListener("click", openSearch);
    });
  }

  // Guarda en window: swapRootAttributes borra los data-* de <html> en cada
  // navegación; si viviera ahí, cada swap registraría otro keydown y Ctrl+K
  // alternaría abrir/cerrar con tantos listeners como visitas previas.
  if (!window.__nxSearchKeys) {
    window.__nxSearchKeys = 1;
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen() ? closeSearch() : openSearch();
        return;
      }
      if (!isOpen()) {
        if (e.key === "/" && !/^(INPUT|TEXTAREA)$/.test((e.target as HTMLElement).tagName)) {
          e.preventDefault();
          openSearch();
        }
        return;
      }
      if (e.key === "Escape") { e.preventDefault(); closeSearch(); }
      // Con el campo vacío, la flecha arriba recalls la última búsqueda.
      if (e.key === "ArrowUp" && ctx && !ctx.input.value && historial.length) {
        e.preventDefault();
        ctx.input.value = historial[0];
        render(ctx.input.value);
        return;
      }
      if (e.key === "ArrowDown") { e.preventDefault(); if (selected < hits.length - 1) { selected++; updateSelected(); } }
      if (e.key === "ArrowUp") { e.preventDefault(); if (selected > 0) { selected--; updateSelected(); } }
      if (e.key === "Enter") {
        const h = selected >= 0 ? hits[selected] : null;
        // OJO: este manejador vive fuera de bind(), así que `input` no
        // existe aquí: el campo se pide a través de ctx.
        const consulta = ctx ? ctx.input.value : "";
        guardarHistorial(consulta);
        if (h) location.href = h.anchor ? `${h.u}#${h.anchor}` : h.u;
      }
    });
    document.addEventListener("astro:before-swap", () => {
      document.body.style.overflow = "";
      hits = [];
      selected = -1;
    });
  }

  bind();
  ensureIndex();
  poblarFiltros();
  document.addEventListener("astro:page-load", async () => {
    bind();
    await ensureIndex();
    poblarFiltros();
  });
</script>

<style is:global>
  #nx-search {
    opacity: 0;
    transition: opacity 0.16s ease;
  }
  #nx-search.nx-open {
    opacity: 1;
  }
  #nx-search #nx-search-panel {
    opacity: 0;
    transform: translateY(10px) scale(0.97);
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #nx-search.nx-open #nx-search-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    :root:not([data-nx-motion="on"]) #nx-search,
    :root:not([data-nx-motion="on"]) #nx-search #nx-search-panel,
    :root:not([data-nx-motion="on"]) #nx-search-list .nx-hit {
      transition: none !important;
      animation: none !important;
    }
  }
  #nx-search-list .nx-hit {
    display: block;
    width: 100%;
    text-align: left;
    border-radius: var(--nx-radius);
    padding: 0.6rem 0.8rem;
    border: 1px solid transparent;
    transition: background 0.12s, border-color 0.12s;
  }
  #nx-search-list .nx-hit:hover,
  #nx-search-list .nx-hit.is-selected {
    background: var(--nx-accent-soft);
    border-color: var(--nx-accent-line);
  }
  #nx-search-list .nx-hit .nx-hit-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.12s, transform 0.12s;
  }
  #nx-search-list .nx-hit:hover .nx-hit-arrow,
  #nx-search-list .nx-hit.is-selected .nx-hit-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  /* Lo que coincide con la búsqueda: el acento, nunca un color nuevo. */
  .nx-search-mark {
    background: var(--nx-accent-soft);
    color: var(--nx-accent);
    font-weight: 700;
    border-radius: var(--nx-radius);
    padding: 0 2px;
  }
</style>
