---
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import SearchModal from "./../components/SearchModal.astro";
import ShortcutsPanel from "./../components/ShortcutsPanel.astro";
import SiteFooter from "./../components/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
}

const SITE = "https://neonotes-espol.vercel.app";
const { title = "Neonotes", description = "Apuntes de Ingeniería Computacional ESPOL" } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;

// Alcance de la búsqueda: semestre/materia de la página actual. Sirve para
// que los resultados de la materia que estás leyendo salgan primero.
const parts = Astro.url.pathname.split("/").filter(Boolean);
const scope = parts.slice(0, 2).join("/");

// Nota = ruta con 3+ segmentos (sem/mat/slug...). Se usa para el modo
// lectura y para ocultar la barra de tiempo restante.
const isNote = parts.length >= 3;

// El acento es único y lo define tokens.css: ya no hay color por semestre.
---

<!doctype html>
<html lang="es" class={isNote ? "nx-note-page" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Neonotes" />
    <meta property="og:image" content={`${SITE}/og-neonotes.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Neonotes · apuntes de Ingeniería Computacional ESPOL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-neonotes.png`} />
    <meta name="twitter:image:alt" content="Neonotes · apuntes de Ingeniería Computacional ESPOL" />
    <meta name="color-scheme" content="light dark" />
    <meta id="nx-theme-color" name="theme-color" content="#f4f8fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <ClientRouter />
    <!-- ── Tema claro/oscuro, antes de pintar ────────────────────────────
         El atributo data-theme tiene que estar en <html> ANTES del primer
         pintado: si se pusiera después, la página aparecería un instante en
         el tema contrario y luego saltaría (el "flash" que nadie perdona).

         Por defecto se sigue al sistema (prefers-color-scheme). Si el lector
         elige, se guarda en localStorage ("theme") y manda su elección.
         El script se re-ejecuta en cada navegación porque el router de
         Astro reemplaza los atributos de <html>. -->
    <script is:inline data-astro-rerun>
      (function () {
        var KEY = "theme";
        var root = document.documentElement;
        var t = null;
        try { t = localStorage.getItem(KEY); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.setAttribute("data-theme", t);
        var meta = document.getElementById("nx-theme-color");
        if (meta) meta.setAttribute("content", t === "dark" ? "#0b1318" : "#f4f8fa");
      })();
    </script>
    <!-- Marca de "hay JS": el revelado al hacer scroll solo oculta contenido
         si esta marca existe. Sin JS (o con JS roto) el contenido se ve. -->
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add("nx-js");
    </script>
    <!-- ── Preferencia de movimiento ───────────────────────────────
         El sitio respeta "reducir movimiento" del sistema: con esa
         preferencia el CSS apaga las animaciones y el JS no crea Lenis
         ni Three.js. En el entorno de pruebas el navegador
         reporta SIEMPRE "reduce", así que las animaciones nunca se veían.

         Aquí se resuelve la preferencia real:
           · "auto"  → lo que diga el sistema (comportamiento por defecto)
           · "on"    → forzar animaciones aunque el sistema pida quietud
           · "off"   → forzar quietud aunque el sistema permita movimiento
         Se guarda en localStorage y se puede forzar con ?motion=1|0|auto.
         El atributo data-nx-motion en <html> es lo que lee el CSS; el
         router de Astro borra los atributos de <html> en cada swap, por eso
         este script se re-ejecuta en cada navegación (data-astro-rerun). -->
    <script is:inline data-astro-rerun>
      (function(){
        var KEY = "nx-motion";
        var root = document.documentElement;

        function systemReduced(){
          return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        }
        function readStored(){
          try { return localStorage.getItem(KEY); } catch(e){ return null; }
        }
        function writeStored(v){
          try {
            if (v === "on" || v === "off") localStorage.setItem(KEY, v);
            else localStorage.removeItem(KEY);
          } catch(e){}
        }
        function resolve(){
          var p = readStored();
          if (p === "on" || p === "off") return p;
          return systemReduced() ? "off" : "on";
        }

        // ?motion=1|0|auto fija la preferencia y limpia la URL.
        var q = null;
        try { q = new URLSearchParams(location.search).get("motion"); } catch(e){}
        if (q === "1" || q === "on") writeStored("on");
        else if (q === "0" || q === "off") writeStored("off");
        else if (q === "auto") writeStored(null);
        try {
          if (q !== null) {
            var u = new URL(location.href);
            u.searchParams.delete("motion");
            history.replaceState(history.state, "", u.pathname + u.search + u.hash);
          }
        } catch(e){}

        // El atributo es lo que lee el CSS: "on" = anima, "off" = quieto.
        root.setAttribute("data-nx-motion", resolve());

        if (!window.__nxMotion) {
          window.__nxMotion = {
            /** preferencia del usuario: "auto" | "on" | "off" */
            pref: "auto",
            /** estado efectivo: ¿deben correr las animaciones? */
            effective: function(){
              return resolve() === "on";
            },
            /**
             * Cambia la preferencia. Recarga porque el JS de animación
             * (Lenis, Three.js) se decide al arrancar: cambiarlo
             * en caliente dejaría la página a medias.
             */
            set: function(v){
              writeStored(v === "on" || v === "off" ? v : null);
              try { sessionStorage.setItem("nx-motion-scroll", String(window.scrollY)); } catch(e){}
              location.reload();
            }
          };
        }
        // La preferencia se relee en cada navegación (puede haber cambiado
        // en otra pestaña) para que el panel de atajos muestre el estado real.
        window.__nxMotion.pref = readStored() || "auto";

        // Recupera la posición de scroll tras el cambio de preferencia.
        try {
          var y = sessionStorage.getItem("nx-motion-scroll");
          if (y) {
            sessionStorage.removeItem("nx-motion-scroll");
            setTimeout(function(){ window.scrollTo(0, parseInt(y, 10) || 0); }, 0);
          }
        } catch(e){}
      })();
    </script>
    <!-- ── Preferencia de emojis ──────────────────────────────────
         El vault usa emojis en los títulos y en los callouts. Aquí se
         decide si se ven: por defecto sí, y el interruptor "Emojis: sí/no"
         de la nota lo cambia (se guarda en localStorage).

         El atributo data-nx-emojis en <html> es lo que lee el CSS; el
         router de Astro borra los atributos de <html> en cada swap, por eso
         este script se re-ejecuta en cada navegación (data-astro-rerun). -->
    <script is:inline data-astro-rerun>
      (function(){
        var KEY = "nx-emojis";
        var root = document.documentElement;
        function readStored(){
          try { return localStorage.getItem(KEY); } catch(e){ return null; }
        }
        function writeStored(v){
          try { localStorage.setItem(KEY, v); } catch(e){}
        }
        function resolve(){
          var p = readStored();
          return p === "off" ? "off" : "on";
        }
        root.setAttribute("data-nx-emojis", resolve());
        if (!window.__nxEmojis) {
          window.__nxEmojis = {
            /** ¿se ven los emojis? */
            on: function(){ return resolve() === "on"; },
            /** cambia la preferencia y lo aplica sin recargar */
            set: function(v){
              writeStored(v === "off" ? "off" : "on");
              root.setAttribute("data-nx-emojis", v === "off" ? "off" : "on");
            }
          };
        }
      })();
    </script>
    <!-- Librerías de animación (servidas localmente, sin CDN externo) -->
    <script src="/gsap.min.js" is:inline></script>
    <script src="/ScrollTrigger.min.js" is:inline></script>

    <script is:inline>
      window.gsap.registerPlugin(window.ScrollTrigger);
    </script>
    <script src="/lenis.min.js" is:inline></script>
    <style is:global>
      @import "../styles/nexus.css";
    </style>
  </head>
  <body>
    <slot />
    {/* Pie común: marca, avisos, fecha y el acceso a los atajos. Se monta
        aquí para que TODAS las páginas (portada, semestre, materia, nota
        y 404) terminen igual. */}
    <SiteFooter />
    <SearchModal scope={scope} />
    <ShortcutsPanel />

    <!-- Aviso de secuencia: al pulsar "g" se muestra qué teclas faltan.
         Sin esto la secuencia "g h" es indescubrible: al pulsar "g" no
         pasa nada visible y parece que el atajo está roto. -->
    <div id="nx-seq-hint" aria-live="polite" data-astro-transition-persist="nx-seq-hint"></div>

    <!-- Barra de progreso de scroll (la anima GSAP en Base) -->
    <div id="nx-scroll-progress" data-astro-transition-persist="nx-scroll-progress"></div>

    <!-- Botón volver arriba con anillo de progreso (lo anima GSAP en Base) -->
    <button
      id="nx-top"
      type="button"
      aria-label="Volver arriba"
      data-astro-transition-persist="nx-top"
    >
      <svg viewBox="0 0 44 44" aria-hidden="true">
        <circle class="nx-top-ring" cx="22" cy="22" r="19" pathLength="100"></circle>
      </svg>
      <span aria-hidden="true">↑</span>
    </button>

    <script>
      (function(){
        var booted = false;
        var lastRoute = "";
        var pageTweens = [];

        function track(tw){ pageTweens.push(tw); return tw; }

        // ── Preferencia de movimiento ─────────────────────────────
        // "reducir movimiento" del sistema apaga las animaciones (el CSS
        // muestra el contenido y aquí no se crean tweens). El usuario puede
        // forzarlo con ?motion=1|0 o desde el panel de atajos: eso se resuelve
        // en window.__nxMotion (ver el script del <head>), y se consulta en
        // caliente para que un cambio de preferencia se note sin recargar.
        function nxReduced(){
          var m = window.__nxMotion;
          if (m && typeof m.effective === "function") return !m.effective();
          return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        }

        // ── Botón "copiar" en cada bloque de código de las notas ──
        function nxCopyBind(){
          var pres = document.querySelectorAll(".note-prose pre");
          for (var i = 0; i < pres.length; i++) {
            (function(pre){
              if (pre.dataset.nxCopyBound) return;
              pre.dataset.nxCopyBound = "1";

              // Nombre del bloque: el lenguaje del valla (python, sql, ...).
              var code = pre.querySelector("code");
              var lang = "";
              if (code) {
                var m = (code.className || "").match(/language-([\w-]+)/);
                if (m) lang = m[1];
              }
              if (lang) pre.setAttribute("data-lang", lang);

              // Indicador de línea cortada: solo si el bloque se desplaza.
              var marcar = function(){
                if (pre.scrollWidth > pre.clientWidth + 2) pre.classList.add("is-scrollable");
                else pre.classList.remove("is-scrollable");
              };
              marcar();
              if (typeof ResizeObserver !== "undefined") {
                new ResizeObserver(marcar).observe(pre);
              }
              pre.addEventListener("scroll", marcar, { passive: true });

              var btn = document.createElement("button");
              btn.type = "button";
              btn.className = "nx-copy";
              btn.textContent = "copiar";
              btn.setAttribute("aria-label", "Copiar el código");
              btn.addEventListener("click", function(){
                var code = pre.querySelector("code");
                var text = (code || pre).textContent || "";
                var ok = function(){
                  btn.textContent = "copiado ✓";
                  btn.classList.add("is-ok");
                  setTimeout(function(){
                    btn.textContent = "copiar";
                    btn.classList.remove("is-ok");
                  }, 1600);
                };
                // Respaldo para cuando la API moderna falla (permiso
                // denegado, documento sin foco, contexto no seguro).
                var fallback = function(){
                  var ta = document.createElement("textarea");
                  ta.value = text;
                  ta.setAttribute("readonly", "");
                  ta.style.position = "fixed";
                  ta.style.opacity = "0";
                  document.body.appendChild(ta);
                  ta.select();
                  try { ta.setSelectionRange(0, ta.value.length); } catch(e){}
                  var done = false;
                  try { done = document.execCommand("copy"); } catch(e){}
                  ta.remove();
                  if (done) ok();
                };
                if (navigator.clipboard && navigator.clipboard.writeText) {
                  navigator.clipboard.writeText(text).then(ok, fallback);
                } else {
                  fallback();
                }
              });
              pre.appendChild(btn);
            })(pres[i]);
          }
        }

        // ── Atajos de teclado: g h (inicio), g i (índice), g b (buscar), / ──
        function nxShortcuts(){
          // La guarda va en window: swapRootAttributes borra los data-* de
          // <html> en cada navegación y el listener se duplicaría.
          if (window.__nxKeys) return;
          window.__nxKeys = 1;
          var pending = false;
          var timer = null;
          var goto = function(url){
            var a = document.createElement("a");
            a.href = url;
            document.body.appendChild(a);
            a.click();
            a.remove();
          };
          var openSearch = function(){
            var btn = document.querySelector(".nx-search-open");
            if (btn) btn.click();
          };

          // Aviso de secuencia: al pulsar "g" se dice qué teclas cierran el
          // atajo. Es lo que hace descubrible el patrón "g + otra tecla".
          var SEQ = [
            { k: "h", label: "Inicio" },
            { k: "i", label: "Índice" },
            { k: "b", label: "Buscar" }
          ];
          // El aviso se busca por id en cada llamada: el nodo se recrea al
          // navegar y una referencia guardada apuntaría al nodo viejo.
          var showSeq = function(){
            var el = document.getElementById("nx-seq-hint");
            if (!el) return;
            el.innerHTML =
              '<span class="nx-seq-lead">g</span>' +
              '<span class="nx-seq-then">luego</span>' +
              SEQ.map(function(s){
                return '<span class="nx-seq-item"><kbd class="nx-kbd">' + s.k +
                  '</kbd><span class="nx-seq-label">' + s.label + '</span></span>';
              }).join("");
            el.classList.add("is-on");
          };
          var hideSeq = function(){
            var el = document.getElementById("nx-seq-hint");
            if (el) el.classList.remove("is-on");
          };

          document.addEventListener("keydown", function(e){
            if (e.metaKey || e.ctrlKey || e.altKey) return;
            var t = e.target;
            if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" ||
              (t as HTMLElement).isContentEditable)) return;
            var modal = document.getElementById("nx-search");
            if (modal && !modal.classList.contains("hidden")) return;
            // Con el panel de atajos abierto no se ejecutan otros atajos.
            var scPanel = document.getElementById("nx-shortcuts");
            if (scPanel && !scPanel.classList.contains("hidden")) return;
            if (pending) {
              pending = false;
              clearTimeout(timer);
              hideSeq();
              if (e.key === "h") { e.preventDefault(); goto("/"); }
              else if (e.key === "i") { e.preventDefault(); goto("/#semestres"); }
              else if (e.key === "b") { e.preventDefault(); openSearch(); }
              return;
            }
            if (e.key === "/") { e.preventDefault(); openSearch(); return; }
            if (e.key === "g") {
              pending = true;
              clearTimeout(timer);
              showSeq();
              timer = setTimeout(function(){
                pending = false;
                hideSeq();
              }, 1400);
            }
          });

          // El panel de atajos (tecla "?" y botón del header) lo gestiona
          // ShortcutsPanel.astro: aquí solo viven las secuencias "g + tecla".
        }

        // ── Dirección de la transición (adelante/atrás) para el CSS ──
        // Ojo: swapRootAttributes borra todos los atributos de <html> al
        // sustituir el documento, así que el dato se guarda en una variable
        // y se vuelve a aplicar en after-swap (justo antes de que corran las
        // animaciones de view-transition).
        function nxDirBind(){
          if (window.__nxDirBound) return;
          window.__nxDirBound = 1;
          var dir = "forward";
          document.addEventListener("astro:before-swap", function(e){
            dir = (e as any).direction === "back" ? "back" : "forward";
            document.documentElement.dataset.nxDir = dir;
          });
          document.addEventListener("astro:after-swap", function(){
            document.documentElement.dataset.nxDir = dir;
          });
        }

        function initAnimations(){
          if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
          gsap.registerPlugin(ScrollTrigger);

          // ── Arranque único: Lenis, barra de progreso, cursor, botón arriba ──
          if (!booted) {
            booted = true;

            nxDirBind();
            nxShortcuts();

            // Con "reducir movimiento": scroll nativo, sin cursor, sin Lenis.
            if (!nxReduced()) {
              var lenis = new Lenis({
                autoRaf: true,
                smooth: true,
                easing: function(t){ return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
                gestureOrientation: 'vertical',
                touchMultiplier: 2,
                wheelMultiplier: 0.8,
                stopInertiaOnNavigate: true
              });
              lenis.on('scroll', ScrollTrigger.update);
              gsap.ticker.add(function(time){ lenis.raf(time * 1000); });
              gsap.ticker.lagSmoothing(0);
              window.__nxLenis = lenis;
            }

            // Barra de progreso de scroll (vive en el markup y persiste entre
            // navegaciones gracias a data-astro-transition-persist)
            var prog = document.getElementById("nx-scroll-progress");
            if (prog && !prog.dataset.nxBound) {
              prog.dataset.nxBound = "1";
              gsap.to(prog, { scaleX: 1, ease: "none",
                scrollTrigger: { start: 0, end: "max", scrub: 0.3 } });
            }

            // Botón volver arriba con anillo de progreso
            var topBtn = document.getElementById("nx-top");
            if (topBtn && !topBtn.dataset.nxBound) {
              topBtn.dataset.nxBound = "1";
              if (nxReduced()) {
                // Sin animación: se muestra directo al llegar a 400px
                gsap.set(topBtn, { autoAlpha: 1 });
                topBtn.style.opacity = "";
              } else {
                gsap.fromTo(topBtn, { autoAlpha: 0, y: 14 },
                  { autoAlpha: 1, y: 0, duration: 0.35, ease: "power2.out",
                    scrollTrigger: { start: 400, toggleActions: "play none none reverse" } });
                gsap.to("#nx-top .nx-top-ring", { strokeDashoffset: 0, ease: "none",
                  scrollTrigger: { start: 0, end: "max", scrub: 0.4 } });
              }
              topBtn.addEventListener("click", function(){
                if (window.__nxLenis) window.__nxLenis.scrollTo(0, { duration: 1.2 });
                else window.scrollTo({ top: 0, behavior: nxReduced() ? "auto" : "smooth" });
              });
            }
          }

          // ── Nota: copiador de código ──
          // Sin animaciones de entrada: el contenido se ve siempre.
          if (document.documentElement.classList.contains("nx-note-page")) {
            nxCopyBind();
          }
        }

        // Re-arranca en cada navegación (ClientRouter) sin duplicar el boot único
        function route(){
          var key = location.pathname + location.search;
          if (key === lastRoute) return;
          lastRoute = key;
          for (var i = 0; i < pageTweens.length; i++) {
            var t = pageTweens[i];
            try { if (t.scrollTrigger) t.scrollTrigger.kill(); if (t.kill) t.kill(); } catch(e){}
          }
          pageTweens = [];
          initAnimations();
          // El swap reemplaza todo el body: los triggers guardados miden
          // posiciones viejas. Se recalculan con el DOM ya montado.
          if (window.ScrollTrigger) {
            requestAnimationFrame(function(){ ScrollTrigger.refresh(); });
          }
        }

        route();
        document.addEventListener("astro:page-load", route);
      })();
    </script>

    <!-- Vercel Analytics: primero de Analytics (script propio de Vercel,
         sin CDN externo). Va al final del body para no retrasar el render. -->
    <Analytics />

    <!-- Favoritos y notas leídas: viven en el localStorage del lector.
         El script se empaqueta una sola vez y se apoya en astro:page-load
         para repintar los botones en cada navegación. -->
    <script>
      import { iniciar as iniciarProgreso } from "../lib/progreso.js";
      iniciarProgreso();
    </script>
  </body>
</html>
