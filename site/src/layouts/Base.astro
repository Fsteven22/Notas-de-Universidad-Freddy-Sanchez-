---
import { ClientRouter } from "astro:transitions";
import SearchModal from "./../components/SearchModal.astro";

interface Props {
  title?: string;
  description?: string;
}

const SITE = "https://neonotes-espol.vercel.app";
const { title = "Neonotes", description = "Apuntes de Ingeniería Computacional ESPOL" } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;

// Alcance de la búsqueda: semestre/materia de la página actual. Sirve para
// que los resultados de la materia que estás leyendo salgan primero.
const scope = Astro.url.pathname.split("/").filter(Boolean).slice(0, 2).join("/");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Neonotes" />
    <meta property="og:image" content={`${SITE}/og-neonotes.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Neonotes · apuntes de Ingeniería Computacional ESPOL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-neonotes.png`} />
    <meta name="twitter:image:alt" content="Neonotes · apuntes de Ingeniería Computacional ESPOL" />
    <meta name="theme-color" content="#05070d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <ClientRouter />
    <!-- Marca de "hay JS": el revelado al hacer scroll solo oculta contenido
         si esta marca existe. Sin JS (o con JS roto) el contenido se ve. -->
    <script is:inline data-astro-rerun>
      document.documentElement.classList.add("nx-js");
    </script>
    <!-- Librerías de animación (servidas localmente, sin CDN externo) -->
    <script src="/gsap.min.js" is:inline></script>
    <script src="/ScrollTrigger.min.js" is:inline></script>
    <script src="/SplitText.min.js" is:inline></script>
    <script src="/ScrambleTextPlugin.min.js" is:inline></script>
    <script is:inline>
      window.gsap.registerPlugin(window.ScrollTrigger, window.SplitText, window.ScrambleText);
    </script>
    <script src="/lenis.min.js" is:inline></script>
    <style is:global>
      @import "../styles/nexus.css";
    </style>
  </head>
  <body>
    <slot />
    <SearchModal scope={scope} />

    <!-- Botón volver arriba con anillo de progreso (lo anima GSAP en Base) -->
    <button id="nx-top" type="button" aria-label="Volver arriba">
      <svg viewBox="0 0 44 44" aria-hidden="true">
        <circle class="nx-top-ring" cx="22" cy="22" r="19" pathLength="100"></circle>
      </svg>
      <span aria-hidden="true">↑</span>
    </button>

    <script>
      /**
       * Revelado al hacer scroll: las tarjetas de la portada y de la materia
       * aparecen conforme llegan, no todas de golpe al cargar. Se apoya en
       * `nx-js` (puesta en el head) para que sin JS nada quede invisible.
       *
       * Un solo observador para toda la vida de la pagina: con el router de
       * cliente el arranque se ejecuta dos veces (carga inicial y
       * `astro:page-load`) y con un observador por arranque cada elemento
       * estaba vigilado dos veces.
       */
      let nxObserver: IntersectionObserver | null = null;

      function nxReveal() {
        // Si GSAP está activo, se encarga él del revelado: no interferir.
        if (window.gsap) return;

        const els = Array.from(
          document.querySelectorAll<HTMLElement>(
            "[data-nx-reveal]:not(.is-visible):not([data-nx-reveal-bound])"
          )
        );
        if (!els.length) return;
        if (!nxObserver) {
          if (!("IntersectionObserver" in window)) {
            for (const el of els) el.classList.add("is-visible");
            return;
          }
          nxObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add("is-visible");
                nxObserver?.unobserve(entry.target);
              }
            },
            { rootMargin: "0px 0px -6% 0px", threshold: 0.04 }
          );
        }
        for (const el of els) {
          el.dataset.nxRevealBound = "1";
          nxObserver.observe(el);
        }
      }

      // Esperar 3s a que GSAP cargue antes del reveal nativo (respaldo)
      setTimeout(nxReveal, 3000);
      document.addEventListener("astro:page-load", function(){ setTimeout(nxReveal, 3000); });
    </script>

    <script>
      (function(){
        var booted = false;
        var lastRoute = "";
        var pageTweens = [];

        function track(tw){ pageTweens.push(tw); return tw; }

        function initAnimations(){
          if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
          gsap.registerPlugin(ScrollTrigger, window.SplitText, window.ScrambleText);

          // ── Arranque único: Lenis, barra de progreso, cursor, botón arriba ──
          if (!booted) {
            booted = true;

            var lenis = new Lenis({
              autoRaf: true,
              smooth: true,
              easing: function(t){ return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
              gestureOrientation: 'vertical',
              touchMultiplier: 2,
              wheelMultiplier: 0.8,
              stopInertiaOnNavigate: true
            });
            lenis.on('scroll', ScrollTrigger.update);
            gsap.ticker.add(function(time){ lenis.raf(time * 1000); });
            gsap.ticker.lagSmoothing(0);
            window.__nxLenis = lenis;

            // Barra de progreso de scroll (siempre visible al navegar)
            var prog = document.createElement("div");
            prog.id = "nx-scroll-progress";
            document.body.appendChild(prog);
            gsap.to(prog, { scaleX: 1, ease: "none",
              scrollTrigger: { start: 0, end: "max", scrub: 0.3 } });

            // Cursor glow personalizado (solo en puntero fino)
            if (window.matchMedia("(pointer: fine)").matches) {
              var cur = document.createElement("div");
              cur.id = "nx-cursor";
              document.body.appendChild(cur);
              var qx = gsap.quickTo(cur, "x", { duration: 0.18, ease: "power3.out" });
              var qy = gsap.quickTo(cur, "y", { duration: 0.18, ease: "power3.out" });
              var shown = false;
              window.addEventListener("mousemove", function(e){
                qx(e.clientX); qy(e.clientY);
                if (!shown) { shown = true; gsap.to(cur, { opacity: 0.6, duration: 0.4 }); }
              }, { passive: true });
              document.addEventListener("mouseover", function(e){
                var t = e.target as Element | null;
                var hit = t && t.closest ? t.closest("a, button, .nx-card, input, kbd") : null;
                gsap.to(cur, { scale: hit ? 2.3 : 1, opacity: hit ? 0.95 : 0.6,
                  duration: 0.3, ease: "power2.out" });
              });
            }

            // Botón volver arriba con anillo de progreso
            var topBtn = document.getElementById("nx-top");
            if (topBtn) {
              gsap.fromTo(topBtn, { autoAlpha: 0, y: 14 },
                { autoAlpha: 1, y: 0, duration: 0.35, ease: "power2.out",
                  scrollTrigger: { start: 400, toggleActions: "play none none reverse" } });
              gsap.to("#nx-top .nx-top-ring", { strokeDashoffset: 0, ease: "none",
                scrollTrigger: { start: 0, end: "max", scrub: 0.4 } });
              topBtn.addEventListener("click", function(){
                if (window.__nxLenis) window.__nxLenis.scrollTo(0, { duration: 1.2 });
                else window.scrollTo({ top: 0, behavior: "smooth" });
              });
            }
          }

          // ── Revelado al scroll (por página) ──
          gsap.utils.toArray("[data-nx-reveal]").forEach(function(el){
            track(gsap.fromTo(el,
              { opacity: 0, y: 24 },
              { opacity: 1, y: 0, duration: 0.7, ease: "power3.out",
                scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" }
              }
            ));
          });

          // Hero home (el h1 lo anima SplitText en index.astro)
          if (window.location.pathname === "/"){
            var tl = gsap.timeline({ defaults: { ease: "power3.out" } });
            tl.from(".nx-badge", { y: 20, opacity: 0, duration: 0.6 })
              .from("p.mt-4.max-w-xl", { y: 20, opacity: 0, duration: 0.6 }, "-=0.3")
              .from(".mt-6.flex", { y: 20, opacity: 0, duration: 0.6 }, "-=0.4")
              .from(".nx-bar", { scaleX: 0, transformOrigin: "left center", duration: 0.8 }, "-=0.6");
            track(tl);

            // Brillo que viaja en loop por la barra de marca
            track(gsap.to(".nx-bar", {
              backgroundPosition: "200% 0", duration: 3.5, repeat: -1, ease: "none"
            }));
          }

          // Stats home
          if (window.location.pathname === "/"){
            gsap.utils.toArray("section.mx-auto.max-w-6xl.px-6.pb-4 .nx-card").forEach(function(card){
              var numberEl = card.querySelector("p.font-mono.text-3xl");
              if (!numberEl) return;
              var target = parseInt(numberEl.textContent, 10);
              if (isNaN(target)) return;
              track(gsap.fromTo(numberEl,
                { innerText: 0 },
                { innerText: target, duration: 1.2, ease: "power2.out", snap: { innerText: 1 },
                  scrollTrigger: { trigger: card, start: "top 85%", toggleActions: "play none none reverse" }
                }
              ));
            });
          }

          // Materia reveals
          if (/^\/\w+\/\w+\/$/.test(window.location.pathname)){
            gsap.utils.toArray(".nx-unit-head").forEach(function(el){
              track(gsap.fromTo(el, { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.6, ease: "power2.out",
                scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none reverse" } }));
            });
            gsap.utils.toArray(".nx-note-row").forEach(function(el, i){
              track(gsap.fromTo(el, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, delay: i * 0.04, ease: "power2.out",
                scrollTrigger: { trigger: el, start: "top 90%", toggleActions: "play none none reverse" } }));
            });
          }

          // ── Scramble en títulos de sección al entrar en pantalla ──
          if (window.ScrambleText) {
            gsap.utils.toArray(".nx-section-title").forEach(function(el){
              var full = (el.textContent || "").replace(/\s+/g, " ").trim();
              if (!full) return;
              var st = ScrollTrigger.create({
                trigger: el, start: "top 90%", once: true,
                onEnter: function(){
                  gsap.to(el, { duration: 1.1,
                    scrambleText: { text: full, chars: "upperCase", speed: 0.4, revealDelay: 0.2 } });
                }
              });
              track({ scrollTrigger: st, kill: function(){ st.kill(); } });
            });

            // Scramble al hover de enlaces marcados con .nx-scramble
            gsap.utils.toArray(".nx-scramble").forEach(function(el){
              if (el.dataset.nxScrambleBound) return;
              el.dataset.nxScrambleBound = "1";
              var original = el.textContent;
              if (!original || !original.trim()) return;
              el.addEventListener("mouseenter", function(){
                gsap.to(el, { duration: 0.55, ease: "none",
                  scrambleText: { text: original, chars: "lowerCase", speed: 0.55, revealDelay: 0.05 } });
              });
            });
          }

          // ── Hover magnético en botones ──
          gsap.utils.toArray(".nx-btn").forEach(function(btn){
            if (btn.dataset.nxMagBound) return;
            btn.dataset.nxMagBound = "1";
            btn.addEventListener("mousemove", function(e){
              var r = btn.getBoundingClientRect();
              gsap.to(btn, {
                x: (e.clientX - r.left - r.width / 2) * 0.25,
                y: (e.clientY - r.top - r.height / 2) * 0.35,
                duration: 0.4, ease: "power3.out"
              });
            });
            btn.addEventListener("mouseleave", function(){
              gsap.to(btn, { x: 0, y: 0, duration: 0.7, ease: "elastic.out(1, 0.4)" });
            });
          });

          // ── Tilt 3D en tarjetas ──
          gsap.utils.toArray(".nx-card").forEach(function(card){
            if (card.dataset.nxTiltBound) return;
            card.dataset.nxTiltBound = "1";
            card.addEventListener("mousemove", function(e){
              var r = card.getBoundingClientRect();
              var px = (e.clientX - r.left) / r.width - 0.5;
              var py = (e.clientY - r.top) / r.height - 0.5;
              gsap.to(card, { rotationY: px * 10, rotationX: -py * 10,
                transformPerspective: 800, duration: 0.4, ease: "power2.out" });
            });
            card.addEventListener("mouseleave", function(){
              gsap.to(card, { rotationY: 0, rotationX: 0, duration: 0.8, ease: "elastic.out(1, 0.5)" });
            });
          });

          // ── Parallax de auras al hacer scroll ──
          gsap.utils.toArray(".nx-aura").forEach(function(a, i){
            track(gsap.to(a, { top: (i % 2 ? "-=140" : "+=140"), ease: "none",
              scrollTrigger: { start: 0, end: "max", scrub: 1.2 } }));
          });
        }

        // Re-arranca en cada navegación (ClientRouter) sin duplicar el boot único
        function route(){
          var key = location.pathname + location.search;
          if (key === lastRoute) return;
          lastRoute = key;
          for (var i = 0; i < pageTweens.length; i++) {
            var t = pageTweens[i];
            try { if (t.scrollTrigger) t.scrollTrigger.kill(); if (t.kill) t.kill(); } catch(e){}
          }
          pageTweens = [];
          initAnimations();
        }

        route();
        document.addEventListener("astro:page-load", route);
      })();
    </script>
  </body>
</html>
