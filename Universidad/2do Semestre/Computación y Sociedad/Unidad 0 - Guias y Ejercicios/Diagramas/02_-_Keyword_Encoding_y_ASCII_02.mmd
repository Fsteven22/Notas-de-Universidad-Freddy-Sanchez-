    B -->|"Sí"| C
    B -->|"No, es muy corto"| D
    C --> E
    E -->|"Sí"| F
    E -->|"No"| D

    style A fill:#e1f5ff
    style D fill:#f5e1ff
    style F fill:#1e3a5f,color:#fff
