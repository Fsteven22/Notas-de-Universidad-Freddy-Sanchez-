flowchart TD
    A["¿Tengo un número entero x?"]
    B{"¿Es positivo o cero?"}
    C["Escribir x en binario normal con n bits"]
    D["Escribir |x| en binario normal con n bits"]
    E["Invertir todos los bits"]
    F["Sumar 1 al resultado"]
    G["Ese es -x en complemento a 2"]
    H["Ese es x, listo"]
    A --> B
    B -->|"Sí"| C
    B -->|"No, es negativo"| D
    D --> E
    E --> F
    F --> G
    C --> H

    style A fill:#e1f5ff
    style G fill:#1e3a5f,color:#fff
    style H fill:#1e3a5f,color:#fff
