flowchart TD
    A["Voy a escribir un email of complaint"]
    B["1. Subject Line clara"]
    C["2. Salutation formal"]
    D["3. Opening Statement: ¿por qué escribo?"]
    E["4. Details: ¿qué pasó exactamente?"]
    F["5. Impact: ¿cómo me afectó?"]
    G["6. Request for Action: ¿qué quiero que hagan?"]
    H["7. Polite Closing Statement"]
    I["8. Sign-off formal"]
    A --> B
    B --> C
    C --> D
    D --> E
    E --> F
    F --> G
    G --> H
    H --> I

    style A fill:#1e3a5f,color:#fff
    style I fill:#2e7d32,color:#fff
