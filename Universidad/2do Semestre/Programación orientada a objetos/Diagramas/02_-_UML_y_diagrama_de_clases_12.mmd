classDiagram
    class DiaSemana {
        <<enumeration>>
        LUNES
        MARTES
        MIERCOLES
        JUEVES
        VIERNES
        SABADO
        DOMINGO
    }
    class TipoCuenta {
        <<enumeration>>
        AHORRO
        CORRIENTE
        NOMINA
        --
        +getTasa(): double
    }
    CuentaBancaria --> TipoCuenta : usa
    class CuentaBancaria {
        -tipo: TipoCuenta
        -saldo: double
    }
