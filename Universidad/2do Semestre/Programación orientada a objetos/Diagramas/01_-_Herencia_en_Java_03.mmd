classDiagram
    Persona <|-- Empleado
    Empleado <|-- Gerente
    Gerente <|-- GerenteGeneral
    class Persona {
        #nombre: String
        #edad: int
    }
    class Empleado {
        #salarioBase: double
        +trabajar(): void
    }
    class Gerente {
        -departamento: String
        -bono: double
        +gestionarEquipo(): void
    }
    class GerenteGeneral {
        -empresas: List~String~
        +dirigirEmpresa(): void
    }
