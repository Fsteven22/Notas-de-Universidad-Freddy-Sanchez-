classDiagram
    Coche "1" *-- "1" Motor : tiene
    Coche "1" *-- "4" Rueda : tiene
    Casa "1" *-- "*" Habitacion : contiene
    class Coche {
        -marca: String
        -motor: Motor
        -ruedas: Rueda[4]
    }
    class Motor {
        -cilindrada: int
        -potencia: int
    }
    class Rueda {
        -tamaño: int
        -presion: double
    }
    class Casa {
        -direccion: String
        -habitaciones: List~Habitacion~
    }
    class Habitacion {
        -nombre: String
        -area: double
    }
