classDiagram
    class Throwable {
        <<Clase raíz>>
        +getMessage()
        +printStackTrace()
    }
    class Error {
        <<Errores graves>>
        OutOfMemoryError
        StackOverflowError
    }
    class Exception {
        <<Excepciones>>
        Recuperables
    }
    class RuntimeException {
        <<No verificadas>>
        NullPointerException
        ArrayIndexOutOfBounds
    }
    class IOException {
        <<Verificadas>>
        FileNotFoundException
    }
    Throwable <|-- Error
    Throwable <|-- Exception
    Exception <|-- RuntimeException
    Exception <|-- IOException
