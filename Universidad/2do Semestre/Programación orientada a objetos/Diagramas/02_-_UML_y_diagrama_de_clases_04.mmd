classDiagram
    Animal <|-- Perro
    Animal <|-- Gato
    Animal <|-- Ave
    class Animal {
        #nombre: String
        #edad: int
        +comer(): void
        +dormir(): void
        +hacerSonido(): void
    }
    class Perro {
        -raza: String
        +ladrar(): void
        +hacerSonido(): void
    }
    class Gato {
        -color: String
        +maullar(): void
        +hacerSonido(): void
    }
    class Ave {
        -especie: String
        +volar(): void
        +hacerSonido(): void
    }
