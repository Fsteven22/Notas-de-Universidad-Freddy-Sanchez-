    C["Brazo r: mayor distancia<br/>del eje mayor τ"]
    D["Ángulo θ"]
    D1["θ = 90° torque máximo"]
    D2["θ = 0 o 180 clásico torque nulo"]
    D3["Componente radial<br/>no contribuye"]
    E["Real"]
    E1["Llave larga da más torque"]
    E2["Puerta: empuja lejos<br/>de las bisagras"]
    E3["Balanza: τ₁ = τ₂<br/>r₁ F₁ = r₂ F₂"]
